## Blackhatbadshah public-repository hygiene

# Environment and secrets
*.env
.env
.env.*
!.env.example
.env.local
.env.*.local
*.pfx
*.publishsettings

# Runtime data — never publish real logs, reports, uploads, databases, or caches
infra/dockerCompose/log-storage/**
**/log-storage/**
**/logs/**
**/reports/**
**/uploads/**
*.sqlite
*.db
*.db-shm
*.db-wal

# Local development state
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# .NET build output
**/bin/
**/obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.rsuser
*.pdb
*.nupkg
*.snupkg

# Node / Python
node_modules/
**/__pycache__/
*.pyc
.venv/
venv/
env/

# Logs and temporary files
*.log
*.tmp
*.cache
*.bak
~$*
*~
