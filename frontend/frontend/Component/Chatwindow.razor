@namespace frontend.Component
@inject IHttpClientFactory ClientFactory
@inject AuthenticationStateProvider AuthStateProvider

<!-- BODY -->
<div class="chat-body">
    @foreach (var msg in messages)
    {
        <div class="chat-msg received">
            @((MarkupString)ConvertToHtml(msg))
        </div>
    }
</div>

<!-- INPUT -->
<div class="chat-input">
    <input placeholder="Type your message…"
           @bind="input"
           @bind:event="oninput"
           @onkeydown="HandleKey" />

    <button @onclick="Send">Send</button>
</div>

@code {
    private string input = string.Empty;
    private string? threadId;
    private readonly List<string> messages = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        threadId =
            user.FindFirst("sid")?.Value ??
            user.FindFirst("sub")?.Value ??
            Guid.NewGuid().ToString();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(input))
            return;

        messages.Add($"**You:** {input}");

        var http = ClientFactory.CreateClient("BlackHatBadshahAi");
        string usermsg = input ;
         input = string.Empty;
        var response = await http.PostAsJsonAsync(
            "chat",
            new { thread_id = threadId, message = usermsg }
        );

       

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ChatResponse>();
            messages.Add($"**AI:** {result?.reply}");
        }
        else
        {
            messages.Add("*AI: Error contacting server*");
        }
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    private string ConvertToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        return Markdown.ToHtml(markdown, pipeline);
    }
}
