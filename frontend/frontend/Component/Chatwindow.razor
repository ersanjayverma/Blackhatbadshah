@namespace frontend.Component
@inject IHttpClientFactory ClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
<!-- BODY -->
<div class="chat-body">
    @foreach (var msg in messages)
    {
        <div class="chat-msg @(msg.IsUser ? "sent" : "received")"
             @key="msg.Id">
            @((MarkupString)ConvertToHtml(msg.Content))
        </div>
    }
</div>

<!-- INPUT -->
<div class="chat-input">
    <input placeholder="Type your message…"
           @bind="input"
           @bind:event="oninput"
           @onkeydown="HandleKey" />

    <button @onclick="Send">Send</button>
</div>

@code {
    private string input = string.Empty;
    private string? threadId;
    private readonly List<ChatMessage> messages = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        threadId =
            user.FindFirst("sid")?.Value ??
            user.FindFirst("sub")?.Value ??
            Guid.NewGuid().ToString();
    }

    private async Task Send()
{
    if (string.IsNullOrWhiteSpace(input)) return;

    messages.Add(new ChatMessage { Content = $"**You:** {input}", IsUser = true });
    var aiMsg = new ChatMessage { Content = "**AI:** ", IsUser = false };
    messages.Add(aiMsg);

    await JS.InvokeVoidAsync("scrollChatToBottom");

    var http = ClientFactory.CreateClient("BlackHatBadshahAi");
    var request = new HttpRequestMessage(HttpMethod.Post, "chat/stream")
    {
        Content = JsonContent.Create(new { thread_id = threadId, message = input })
    };
    input = string.Empty;
    request.SetBrowserResponseStreamingEnabled(true);
  

    using var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
    response.EnsureSuccessStatusCode();

    using var stream = await response.Content.ReadAsStreamAsync();
    using var reader = new StreamReader(stream, System.Text.Encoding.UTF8, true, 128);

    string? line;
    while ((line = await reader.ReadLineAsync()) != null)
    {
        if (string.IsNullOrWhiteSpace(line) || !line.StartsWith("data: ")) continue;

        var payload = line[6..].Trim();
        if (payload == "[DONE]") break;

        try
        {
            var chunk = JsonSerializer.Deserialize<StreamChunk>(
                payload,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true,
                    DefaultBufferSize = 32
                });

            if (chunk?.Token == null) continue;

            aiMsg.Content += chunk.Token;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch
        {
            // ignore partial JSON
        }
    }
}




    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    private string ConvertToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        return Markdown.ToHtml(markdown, pipeline);
    }
}
