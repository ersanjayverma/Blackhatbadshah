@inherits ErrorBoundary
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (CurrentException is not null && !IsOidcException(CurrentException))
{
    <div class="error-modal-backdrop" @onclick="DismissError">
        <div class="error-modal" @onclick:stopPropagation="true">
            <div class="error-modal-header">
                <div class="error-modal-title">
                    System Error
                </div>
                <button class="error-modal-close" @onclick="DismissError">
                    ✕
                </button>
            </div>

            <div class="error-modal-body">
                <div class="error-message">
                    @CurrentException.Message
                </div>

                @if (!string.IsNullOrEmpty(CurrentException.StackTrace))
                {
                    <div class="error-stack-title">
                        Stack Trace:
                    </div>
                    <div class="error-stack">
                        @CurrentException.StackTrace
                    </div>
                }
            </div>

            <div class="error-modal-footer">
                <button class="error-btn error-btn-dismiss" @onclick="DismissError">
                    Dismiss
                </button>
                <button class="error-btn error-btn-reload" @onclick="ReloadPage">
                    Reload Page
                </button>
            </div>
        </div>
    </div>
}

@ChildContent

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        // Redirect to logout on OIDC token failures
        if (IsOidcException(exception))
        {
            Navigation.NavigateTo("/logout", forceLoad: true);
            return Task.CompletedTask;
        }
        
        return base.OnErrorAsync(exception);
    }

    private bool IsOidcException(Exception exception)
    {
        var message = exception.Message ?? "";
        var lowerMessage = message.ToLower();
        
        // OIDC/OAuth 2.0 error codes
        if (lowerMessage.Contains("invalid_grant") ||
            lowerMessage.Contains("invalid_token") ||
            lowerMessage.Contains("token_expired") ||
            lowerMessage.Contains("refresh_token_expired") ||
            lowerMessage.Contains("unauthorized_client") ||
            lowerMessage.Contains("access_denied") ||
            lowerMessage.Contains("invalid_client") ||
            lowerMessage.Contains("invalid_request") ||
            lowerMessage.Contains("unsupported_grant_type"))
            return true;

        // Check inner exceptions recursively
        if (exception.InnerException != null)
            return IsOidcException(exception.InnerException);

        return false;
    }

    private void DismissError()
    {
        Recover();
    }

    private void ReloadPage()
    {
        JS.InvokeVoidAsync("location.reload");
    }
}