@inherits LayoutComponentBase
@using frontend.Component
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiLoaderService Loader

<div class="app-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <!-- MAIN CONTENT -->
    <section class="main">

        <!-- PAGE CONTENT -->
        <main class="content">
            @Body
        </main>

        <!-- GLOBAL API LOADER -->
        @if (Loader.IsBusy)
        {
            <div class="api-loader-overlay">
                <div class="api-loader-box">
                    <div class="spinner-border text-primary"></div>
                    <div class="mt-2">Processing…</div>
                </div>
            </div>
        }

        <!-- CHAT (AUTH AWARE) -->
        <AuthorizeView>
            <Authorized>

                <!-- FLOATING BUTTON -->
                @if (!IsChatOpen)
                {
                    <button class="chat-fab" @onclick="ToggleChat">
                        <span class="material-icons">chat</span>
                    </button>
                }

                <!-- CHAT OVERLAY -->
               @if (IsChatOpen)
                {
                    <div class="chat-overlay @(IsFullscreen ? "fullscreen" : "")">

                        <!-- HEADER -->
                        <div class="chat-header">
                            <span>Blackhat AI</span>
                            <div>
                                <button title="Fullscreen"
                                        @onclick="ToggleFullscreen">⛶</button>
                                <button title="Close"
                                        @onclick="ToggleChat">✕</button>
                            </div>
                        </div>

                        <!-- CHAT CONTENT -->
                        <Chatwindow />
                    </div>
                }

            </Authorized>

            <NotAuthorized>
                <button class="chat-fab disabled" disabled>
                    <span class="material-icons">chat</span>
                </button>
            </NotAuthorized>
        </AuthorizeView>

    </section>
</div>

@code {
    private bool IsChatOpen;
    private bool IsFullscreen;

    private void ToggleChat()
    {
        IsChatOpen = !IsChatOpen;
        if (!IsChatOpen)
            IsFullscreen = false;
    }

    private void ToggleFullscreen()
        => IsFullscreen = !IsFullscreen;

    protected override void OnInitialized()
    {
        Loader.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Loader.OnChange -= StateHasChanged;
    }
}
