@inject IJSRuntime JS
@inject NavigationManager Nav
<nav id="main-nav">
    <!-- Brand -->
    <NavLink href="" Match="NavLinkMatch.All" id="nav-brand-logo" >
        <img src="/images/logobhb.png" alt="BlackHatBadshah" />
    </NavLink>

    <!-- Public -->
    <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" >Home</NavLink>
    <NavLink href="pricing" class="nav-link" >Pricing</NavLink>

    <AuthorizeView>
        <Authorized>
            <NavLink href="analysis" class="nav-link" >Analysis Dashboard</NavLink>
            <NavLink href="log-center" class="nav-link" >Log Center</NavLink>
            <NavLink href="worker-hub" class="nav-link" >Workers</NavLink>
            <NavLink href="linux-manager" class="nav-link" >Linux Manager</NavLink>
            <NavLink href="system-monitor" class="nav-link" >System Monitor</NavLink>
            <NavLink href="subscription" class="nav-link" >My Profile</NavLink>
            <NavLink href="security" class="nav-link" >Security & Privacy</NavLink>
            <NavLink class="nav-link" href="logout" >
                Logout
            </NavLink>
        </Authorized>

        <NotAuthorized>
            <NavLink href="security" class="nav-link" >Security & Privacy</NavLink>
            <NavLink href="login" class="nav-link" >Login/Register</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
      protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await JS.InvokeVoidAsync("closeMobileNav");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

}
