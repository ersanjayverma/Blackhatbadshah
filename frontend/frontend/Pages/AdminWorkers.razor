@page "/admin/workers"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using frontend.Services
@inject WorkerAgentService WorkerAgentApi
@inject ToastService Toast
@inject IJSRuntime JS
@attribute [Authorize]

<AuthorizeView>
    <Authorized>
        <div class="container-fluid px-4 py-4">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <div>
                    <h2 class="mb-1 fw-bold text-gradient">
                        <i class="bi bi-cpu me-2"></i>My Workers
                    </h2>
                    <p class="mb-0">Manage your worker agents for log collection</p>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    @if (_config != null && _config.HasConfig)
                    {
                        <span class="badge bg-info px-3 py-2">
                            <i class="bi bi-stack me-1"></i>
                            @_summary.ActiveWorkers / @_config.MaxWorkers Workers
                        </span>
                    }
                    <span class="badge bg-success px-3 py-2">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                        @_workers.Count(w => w.IsActive) Active
                    </span>
                    <button class="btn btn-outline-primary" @onclick="RefreshAll" disabled="@_loading">
                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-clockwise me-1"></i>
                        }
                        Refresh
                    </button>
                </div>
            </div>

            <!-- CONFIG SECTION -->
            @if (_config == null || !_config.HasConfig)
            {
                <div class="card modern-card shadow-lg mb-4 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>Setup Required
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-3">
                            You need to initialize your worker configuration before registering workers.
                            This will generate a unique Pre-Shared Key (PSK) for your account.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Configuration Name (optional)</label>
                            <input type="text" class="form-control" placeholder="My Production Servers"
                                   @bind="_newConfigName" />
                        </div>
                        <button class="btn btn-primary btn-lg" @onclick="InitializeConfig" disabled="@_initializing">
                            @if (_initializing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-key me-2"></i>Initialize Worker Configuration
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- CONFIG INFO CARD -->
                <div class="card modern-card shadow-sm mb-4">
                    <div class="card-header gradient-header-dark d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-gear me-2"></i>Worker Configuration
                        </h5>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-warning" @onclick="ShowRotatePskModal">
                                <i class="bi bi-arrow-repeat me-1"></i>Rotate PSK
                            </button>
                            <button class="btn btn-sm btn-outline-info" @onclick="ShowInstallInstructions">
                                <i class="bi bi-book me-1"></i>Install Guide
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <small class="fw-bold d-block mb-1">Configuration</small>
                                <span>@(_config.ConfigName ?? "Default")</span>
                            </div>
                            <div class="col-md-3">
                                <small class="fw-bold d-block mb-1">Status</small>
                                @if (_config.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Disabled</span>
                                }
                            </div>
                            <div class="col-md-3">
                                <small class="fw-bold d-block mb-1">Worker Limit</small>
                                <span>@_summary.ActiveWorkers / @_config.MaxWorkers</span>
                            </div>
                            <div class="col-md-3">
                                <small class="fw-bold d-block mb-1">PSK Last Rotated</small>
                                <span>@(_config.LastPskRotatedAt?.ToLocalTime().ToString("g") ?? "Never")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-primary" @onclick="ShowRegisterModal" 
                            disabled="@(_summary.ActiveWorkers >= _config.MaxWorkers)">
                        <i class="bi bi-plus-lg me-1"></i>Register New Worker
                    </button>
                    @if (_summary.ActiveWorkers >= _config.MaxWorkers)
                    {
                        <span class="text-warning align-self-center">
                            <i class="bi bi-info-circle me-1"></i>Worker limit reached
                        </span>
                    }
                </div>
            }

            <!-- FILTER -->
            @if (_config?.HasConfig == true)
            {
                <div class="card modern-card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-funnel me-2"></i>Filter
                                </label>
                                <select class="form-select" @bind="_statusFilter" @bind:after="FilterWorkers">
                                    <option value="all">All Workers</option>
                                    <option value="active">Active Only</option>
                                    <option value="revoked">Revoked Only</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-search me-2"></i>Search
                                </label>
                                <input type="text" class="form-control" placeholder="Search by name..."
                                       @bind="_searchTerm" @bind:event="oninput" @bind:after="FilterWorkers" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- WORKERS LIST -->
            @if (_loading && _workers.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 fw-bold">Loading workers...</p>
                </div>
            }
            else if (_config?.HasConfig == true && _filteredWorkers.Count == 0)
            {
                <div class="card modern-card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-cpu display-1 mb-3"></i>
                        <h5 class="fw-bold">No Workers Found</h5>
                        <p class="fw-bold">
                            @if (!string.IsNullOrEmpty(_searchTerm))
                            {
                                <span>No workers matching "@_searchTerm"</span>
                            }
                            else
                            {
                                <span>Register a worker to start collecting logs.</span>
                            }
                        </p>
                        <button class="btn btn-primary" @onclick="ShowRegisterModal">
                            <i class="bi bi-plus-lg me-1"></i>Register Worker
                        </button>
                    </div>
                </div>
            }
            else if (_config?.HasConfig == true)
            {
                <div class="table-responsive">
                    <table class="table table-hover modern-table">
                        <thead>
                            <tr>
                                <th><i class="bi bi-tag me-1"></i>Name</th>
                                <th><i class="bi bi-fingerprint me-1"></i>Worker ID</th>
                                <th><i class="bi bi-activity me-1"></i>Status</th>
                                <th><i class="bi bi-calendar me-1"></i>Created</th>
                                <th><i class="bi bi-clock me-1"></i>Last Seen</th>
                                <th><i class="bi bi-gear me-1"></i>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in _filteredWorkers)
                            {
                                <tr>
                                    <td class="fw-semibold">@worker.Name</td>
                                    <td>
                                        <code class="small">@worker.Id.ToString()[..8]...</code>
                                        <button class="btn btn-sm btn-link p-0 ms-1" @onclick="() => CopyWorkerId(worker.Id)">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </td>
                                    <td>
                                        @if (worker.IsActive)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>Revoked
                                            </span>
                                        }
                                    </td>
                                    <td>@worker.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td>
                                        @if (worker.LastSeenAt.HasValue)
                                        {
                                            <span>@worker.LastSeenAt.Value.ToLocalTime().ToString("g")</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">Never</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            @if (worker.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        @onclick="() => ShowRotateKeyModal(worker)"
                                                        title="Rotate API Key">
                                                    <i class="bi bi-key"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RevokeWorker(worker)"
                                                        title="Revoke Worker">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        @onclick="() => ReactivateWorker(worker)"
                                                        title="Reactivate Worker"
                                                        disabled="@(_summary.ActiveWorkers >= _config.MaxWorkers)">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DeleteWorker(worker)"
                                                    title="Delete Worker">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- REGISTER WORKER MODAL -->
        @if (_showRegisterModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-plus-circle me-2"></i>Register Worker
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseRegisterModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Worker Name</label>
                                <input type="text" class="form-control" placeholder="e.g., web-server-1, prod-db-primary"
                                       @bind="_newWorkerName" />
                                <small class="form-text">A unique, descriptive name for this worker.</small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseRegisterModal">Cancel</button>
                            <button type="button" class="btn btn-primary" @onclick="RegisterWorker"
                                    disabled="@string.IsNullOrWhiteSpace(_newWorkerName)">
                                <i class="bi bi-check-lg me-1"></i>Register
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- PSK/API KEY MODAL -->
        @if (_showKeyModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-warning text-dark">
                            <h5 class="modal-title">
                                <i class="bi bi-key me-2"></i>@_keyModalTitle
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseKeyModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Important:</strong> This key will only be shown ONCE. Copy it now and store it securely.
                            </div>
                            
                            @if (!string.IsNullOrEmpty(_displayWorkerId))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Worker ID</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control font-monospace" value="@_displayWorkerId" readonly />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(_displayWorkerId)">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">@_keyLabel</label>
                                <div class="input-group">
                                    <input type="@(_showKey ? "text" : "password")" class="form-control font-monospace"
                                           value="@_displayKey" readonly />
                                    <button class="btn btn-outline-secondary" @onclick="ToggleKeyVisibility">
                                        <i class="bi @(_showKey ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                    <button class="btn btn-primary" @onclick="() => CopyToClipboard(_displayKey)">
                                        <i class="bi bi-clipboard me-1"></i>Copy
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(_displayWorkerId))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Environment Variables</label>
                                    <pre class="bg-dark text-light p-3 rounded small"><code>BHB_WORKER_ID=@_displayWorkerId
BHB_WORKER_KEY=@_displayKey
BHB_API_URL=https://api.blackhatbadshah.com</code></pre>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" @onclick="CloseKeyModal">
                                <i class="bi bi-check-lg me-1"></i>I've Saved the Key
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- INSTALL INSTRUCTIONS MODAL -->
        @if (_showInstallModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-book me-2"></i>Worker Installation Guide
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseInstallModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-info mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Before you begin:</strong> Make sure you have registered a worker and saved the API Key and Worker ID.
                            </div>
                            
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link @(_installTab == "linux" ? "active" : "")" 
                                            @onclick='() => _installTab = "linux"'>
                                        <i class="bi bi-ubuntu me-1"></i>Linux (systemd)
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(_installTab == "windows" ? "active" : "")"
                                            @onclick='() => _installTab = "windows"'>
                                        <i class="bi bi-windows me-1"></i>Windows Service
                                    </button>
                                </li>
                            </ul>
                            
                            <div class="tab-content mt-3">
                                @if (_installTab == "linux" && _instructions != null)
                                {
                                    <div>
                                        <h6 class="fw-bold">Linux Installation (Complete Steps)</h6>
                                        <p class="small text-secondary">Copy and run these commands in your terminal:</p>
                                        <pre class="bg-dark text-light p-3 rounded small" style="max-height: 500px; overflow-y: auto; white-space: pre-wrap;">@_instructions.LinuxInstallCommands</pre>
                                        
                                        <div class="alert alert-warning mt-3">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            <strong>Important:</strong> Replace <code>YOUR_API_KEY_HERE</code> and <code>YOUR_WORKER_ID_HERE</code> 
                                            in the appsettings.json with the values from your registered worker.
                                        </div>
                                    </div>
                                }
                                else if (_installTab == "windows" && _instructions != null)
                                {
                                    <div>
                                        <h6 class="fw-bold">Windows Service Installation</h6>
                                        <p class="small text-secondary">Run PowerShell as Administrator and execute these commands:</p>
                                        <pre class="bg-dark text-light p-3 rounded small" style="max-height: 500px; overflow-y: auto; white-space: pre-wrap;">@_instructions.WindowsServiceCommands</pre>
                                        
                                        <div class="alert alert-warning mt-3">
                                            <i class="bi bi-exclamation-triangle me-2"></i>
                                            <strong>Important:</strong> Replace <code>YOUR_API_KEY_HERE</code> and <code>YOUR_WORKER_ID_HERE</code> 
                                            in the appsettings.json with the values from your registered worker.
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="https://github.com/ersanjayverma/Blackhatbadshah/tree/master/worker/bhbworker" 
                               target="_blank" class="btn btn-outline-primary">
                                <i class="bi bi-github me-1"></i>View on GitHub
                            </a>
                            <button type="button" class="btn btn-secondary" @onclick="CloseInstallModal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="alert alert-warning shadow-sm">
                <i class="bi bi-lock me-2"></i>
                You must be logged in to manage workers.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserWorkerConfigResponse? _config;
    private WorkerSummaryResponse _summary = new();
    private List<WorkerAgentListItem> _workers = new();
    private List<WorkerAgentListItem> _filteredWorkers = new();
    private bool _loading = true;
    private bool _initializing = false;
    private string _statusFilter = "all";
    private string _searchTerm = string.Empty;
    private string _newConfigName = string.Empty;

    // Register modal
    private bool _showRegisterModal = false;
    private string _newWorkerName = string.Empty;

    // Key modal (for PSK, API keys)
    private bool _showKeyModal = false;
    private string _keyModalTitle = string.Empty;
    private string _keyLabel = string.Empty;
    private string _displayWorkerId = string.Empty;
    private string _displayKey = string.Empty;
    private bool _showKey = false;

    // Install instructions modal
    private bool _showInstallModal = false;
    private WorkerInstallInstructions? _instructions;
    private string _installTab = "linux";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAll();
    }

    private async Task RefreshAll()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _config = await WorkerAgentApi.GetConfigAsync();
            
            if (_config.HasConfig)
            {
                _summary = await WorkerAgentApi.GetSummaryAsync();
                _workers = await WorkerAgentApi.GetAllAsync();
                FilterWorkers();
            }
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("401"))
        {
            // Authentication issue - user may need to re-login
            Toast.ShowWarning("Please log in again to access this page.");
            _config = new UserWorkerConfigResponse { HasConfig = false };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"RefreshAll error: {ex}");
            Toast.ShowError($"Failed to load data: {ex.Message}");
            _config = new UserWorkerConfigResponse { HasConfig = false };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task InitializeConfig()
    {
        _initializing = true;
        StateHasChanged();

        try
        {
            var result = await WorkerAgentApi.InitializeConfigAsync(
                string.IsNullOrWhiteSpace(_newConfigName) ? null : _newConfigName);

            _keyModalTitle = "Worker Configuration Initialized";
            _keyLabel = "Pre-Shared Key (PSK)";
            _displayWorkerId = string.Empty;
            _displayKey = result.Psk;
            _showKey = false;
            _showKeyModal = true;

            Toast.ShowSuccess("Configuration initialized! Save your PSK securely.");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to initialize: {ex.Message}");
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    private void FilterWorkers()
    {
        _filteredWorkers = _workers
            .Where(w =>
            {
                if (_statusFilter == "active" && !w.IsActive) return false;
                if (_statusFilter == "revoked" && !w.IsRevoked) return false;

                if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    return w.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase);
                }

                return true;
            })
            .OrderByDescending(w => w.CreatedAt)
            .ToList();
    }

    private void ShowRegisterModal()
    {
        _newWorkerName = string.Empty;
        _showRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        _showRegisterModal = false;
    }

    private async Task RegisterWorker()
    {
        if (string.IsNullOrWhiteSpace(_newWorkerName))
            return;

        try
        {
            var result = await WorkerAgentApi.RegisterAsync(_newWorkerName);

            _showRegisterModal = false;
            _keyModalTitle = "Worker Registered Successfully";
            _keyLabel = "Worker API Key";
            _displayWorkerId = result.WorkerId.ToString();
            _displayKey = result.ApiKey;
            _showKey = false;
            _showKeyModal = true;

            Toast.ShowSuccess($"Worker '{_newWorkerName}' registered!");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to register: {ex.Message}");
        }
    }

    private async void ShowRotateKeyModal(WorkerAgentListItem worker)
    {
        await RotateKey(worker);
    }

    private async Task RotateKey(WorkerAgentListItem worker)
    {
        try
        {
            var result = await WorkerAgentApi.RotateKeyAsync(worker.Id);

            _keyModalTitle = "API Key Rotated";
            _keyLabel = "New Worker API Key";
            _displayWorkerId = result.WorkerId.ToString();
            _displayKey = result.ApiKey;
            _showKey = false;
            _showKeyModal = true;

            Toast.ShowSuccess($"API key rotated for '{worker.Name}'!");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to rotate key: {ex.Message}");
        }
    }

    private async void ShowRotatePskModal()
    {
        await RotatePsk();
    }

    private async Task RotatePsk()
    {
        try
        {
            var result = await WorkerAgentApi.RotatePskAsync();

            _keyModalTitle = "PSK Rotated";
            _keyLabel = "New Pre-Shared Key (PSK)";
            _displayWorkerId = string.Empty;
            _displayKey = result.Psk;
            _showKey = false;
            _showKeyModal = true;

            Toast.ShowSuccess("PSK rotated! Update all your workers.");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to rotate PSK: {ex.Message}");
        }
    }

    private async Task RevokeWorker(WorkerAgentListItem worker)
    {
        try
        {
            await WorkerAgentApi.RevokeAsync(worker.Id);
            Toast.ShowSuccess($"Worker '{worker.Name}' revoked!");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to revoke: {ex.Message}");
        }
    }

    private async Task ReactivateWorker(WorkerAgentListItem worker)
    {
        try
        {
            var result = await WorkerAgentApi.ReactivateAsync(worker.Id);

            _keyModalTitle = "Worker Reactivated";
            _keyLabel = "New Worker API Key";
            _displayWorkerId = result.WorkerId.ToString();
            _displayKey = result.ApiKey;
            _showKey = false;
            _showKeyModal = true;

            Toast.ShowSuccess($"Worker '{worker.Name}' reactivated!");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to reactivate: {ex.Message}");
        }
    }

    private async Task DeleteWorker(WorkerAgentListItem worker)
    {
        try
        {
            await WorkerAgentApi.DeleteAsync(worker.Id);
            Toast.ShowSuccess($"Worker '{worker.Name}' deleted!");
            await RefreshAll();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to delete: {ex.Message}");
        }
    }

    private async Task ShowInstallInstructions()
    {
        try
        {
            _instructions = await WorkerAgentApi.GetInstallInstructionsAsync();
            _installTab = "linux";
            _showInstallModal = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load instructions: {ex.Message}");
        }
    }

    private void CloseInstallModal()
    {
        _showInstallModal = false;
    }

    private void CloseKeyModal()
    {
        _showKeyModal = false;
        _displayKey = string.Empty;
        _displayWorkerId = string.Empty;
    }

    private void ToggleKeyVisibility()
    {
        _showKey = !_showKey;
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.ShowSuccess("Copied to clipboard!");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to copy: {ex.Message}");
        }
    }

    private async Task CopyWorkerId(Guid workerId)
    {
        await CopyToClipboard(workerId.ToString());
    }
}
