@page "/analysis-dashboard"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using frontend.Services
@using frontend.Services.Interfaces
@using shared.Dto
@inject IReportService ReportService
@inject HubConnectionService HubService
@inject IAccessTokenProvider TokenProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>
        <div class="container-fluid px-4 py-4">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <div>
                    <h2 class="mb-1 fw-bold text-gradient">
                        <i class="bi bi-graph-up-arrow me-2"></i>Analysis Dashboard
                    </h2>
                    <p class="mb-0">View your log analyses by date and time with detailed graphs</p>
                </div>
                <button class="btn btn-outline-primary" @onclick="RefreshData" disabled="@_loading">
                    <i class="bi bi-arrow-clockwise me-2"></i>Refresh
                </button>
            </div>

            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
                    <p class="fw-semibold">Loading analysis data...</p>
                </div>
            }
            else
            {
                <!-- SUMMARY CARDS - CLICKABLE -->
                <div class="row g-4 mb-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="card modern-card shadow-sm stat-card clickable" @onclick="() => ShowDetailModal('Total')">
                            <div class="card-body text-center">
                                <i class="bi bi-file-earmark-text stat-icon text-primary"></i>
                                <h3 class="stat-value">@_analyses.Count</h3>
                                <p class="stat-label">Total Analyses</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card modern-card shadow-sm stat-card clickable" @onclick="() => ShowDetailModal('Completed')">
                            <div class="card-body text-center">
                                <i class="bi bi-check-circle stat-icon text-success"></i>
                                <h3 class="stat-value text-success">@_analyses.Count(a => a.Status == ReportStatus.Completed)</h3>
                                <p class="stat-label">Completed</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card modern-card shadow-sm stat-card clickable" @onclick="() => ShowDetailModal('InProgress')">
                            <div class="card-body text-center">
                                <i class="bi bi-hourglass-split stat-icon text-warning"></i>
                                <h3 class="stat-value text-warning">@_analyses.Count(a => a.Status == ReportStatus.InProgress)</h3>
                                <p class="stat-label">In Progress</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="card modern-card shadow-sm stat-card clickable" @onclick="() => ShowDetailModal('Failed')">
                            <div class="card-body text-center">
                                <i class="bi bi-x-circle stat-icon text-danger"></i>
                                <h3 class="stat-value text-danger">@_analyses.Count(a => a.Status == ReportStatus.Failed)</h3>
                                <p class="stat-label">Failed</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DATE RANGE FILTER -->
                <div class="card modern-card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">From Date</label>
                                <input type="date" class="form-control" @bind="_fromDate" @bind:after="FilterAnalyses" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">To Date</label>
                                <input type="date" class="form-control" @bind="_toDate" @bind:after="FilterAnalyses" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Status</label>
                                <select class="form-select" @bind="_statusFilter" @bind:after="FilterAnalyses">
                                    <option value="">All Statuses</option>
                                    <option value="Completed">Completed</option>
                                    <option value="InProgress">In Progress</option>
                                    <option value="Failed">Failed</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DAILY ANALYSIS CHART -->
                <div class="card modern-card shadow-lg mb-4">
                    <div class="card-header gradient-header-dark">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar3 me-2"></i>Daily Analysis Trend
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container" style="height: 350px;">
                            <canvas id="dailyAnalysisChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- HOURLY DISTRIBUTION CHART -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-6">
                        <div class="card modern-card shadow-lg">
                            <div class="card-header gradient-header-dark">
                                <h5 class="mb-0">
                                    <i class="bi bi-clock me-2"></i>Hourly Distribution
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="chart-container" style="height: 300px;">
                                    <canvas id="hourlyChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card modern-card shadow-lg">
                            <div class="card-header gradient-header-dark">
                                <h5 class="mb-0">
                                    <i class="bi bi-pie-chart me-2"></i>Status Distribution
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="chart-container" style="height: 300px;">
                                    <canvas id="statusPieChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ANALYSIS TIMELINE -->
                <div class="card modern-card shadow-lg">
                    <div class="card-header gradient-header-dark d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history me-2"></i>Analysis Timeline
                        </h5>
                        <span class="badge bg-primary">@_filteredAnalyses.Count analyses</span>
                    </div>
                    <div class="card-body p-0">
                        @if (_filteredAnalyses.Count == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox display-1 mb-3"></i>
                                <h5 class="fw-bold">No analyses found</h5>
                                <p>Try adjusting your date range or status filter</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 modern-table">
                                    <thead>
                                        <tr>
                                            <th><i class="bi bi-calendar me-1"></i>Date & Time</th>
                                            <th><i class="bi bi-file-text me-1"></i>Title</th>
                                            <th><i class="bi bi-activity me-1"></i>Status</th>
                                            <th><i class="bi bi-lightbulb me-1"></i>Summary</th>
                                            <th><i class="bi bi-gear me-1"></i>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var analysis in _filteredAnalyses.OrderByDescending(a => a.CreatedAt).Take(50))
                                        {
                                            <tr class="analysis-card" @onclick="() => ViewReport(analysis.Id)">
                                                <td class="fw-semibold">
                                                    @analysis.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                                </td>
                                                <td>@analysis.Title</td>
                                                <td>
                                                    @switch (analysis.Status)
                                                    {
                                                        case ReportStatus.InProgress:
                                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                                <i class="bi bi-hourglass-split me-1"></i>In Progress
                                                            </span>
                                                            break;
                                                        case ReportStatus.Completed:
                                                            <span class="badge bg-success px-3 py-2">
                                                                <i class="bi bi-check-circle me-1"></i>Completed
                                                            </span>
                                                            break;
                                                        case ReportStatus.Failed:
                                                            <span class="badge bg-danger px-3 py-2">
                                                                <i class="bi bi-x-circle me-1"></i>Failed
                                                            </span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="small" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                    @analysis.Summary
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-primary" @onclick:stopPropagation="true"
                                                            @onclick="() => ViewReport(analysis.Id)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- DETAIL MODAL -->
        @if (_showDetailModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-info-circle me-2"></i>@_detailModalTitle Analyses
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
                        </div>
                        <div class="modal-body detail-modal-content">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Title</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _detailModalItems)
                                        {
                                            <tr class="analysis-card" @onclick="() => ViewReport(item.Id)">
                                                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                                                <td>@item.Title</td>
                                                <td>
                                                    @switch (item.Status)
                                                    {
                                                        case ReportStatus.Completed:
                                                            <span class="badge bg-success">Completed</span>
                                                            break;
                                                        case ReportStatus.InProgress:
                                                            <span class="badge bg-warning text-dark">In Progress</span>
                                                            break;
                                                        case ReportStatus.Failed:
                                                            <span class="badge bg-danger">Failed</span>
                                                            break;
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="alert alert-warning shadow-sm">
                <i class="bi bi-lock me-2"></i>
                You must be logged in to view the analysis dashboard.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private List<ReportListItem> _analyses = new();
    private List<ReportListItem> _filteredAnalyses = new();
    private DateTime _fromDate = DateTime.Now.AddDays(-30);
    private DateTime _toDate = DateTime.Now;
    private string _statusFilter = "";

    // Detail modal
    private bool _showDetailModal = false;
    private string _detailModalTitle = "";
    private List<ReportListItem> _detailModalItems = new();

    private IDisposable? _reportStatusChangedSubscription;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            await HubService.InitializeAsync(async () =>
            {
                var tokenResult = await TokenProvider.RequestAccessToken();
                if (tokenResult.TryGetToken(out var token))
                {
                    return token.Value;
                }
                return null;
            });
            await HubService.StartAsync();

            _reportStatusChangedSubscription = HubService.On<Guid, ReportStatus>("ReportStatusChanged",
                async (reportId, status) =>
                {
                    await RefreshData();
                    await InvokeAsync(StateHasChanged);
                });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection failed: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _analyses = await ReportService.GetAllAsync() ?? new();
            FilterAnalyses();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load data: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }

        // Render charts
        await Task.Delay(100);
        await RenderCharts();
    }

    private void FilterAnalyses()
    {
        _filteredAnalyses = _analyses
            .Where(a =>
            {
                // Date filter
                var date = a.CreatedAt.Date;
                if (date < _fromDate.Date || date > _toDate.Date)
                    return false;

                // Status filter
                if (!string.IsNullOrEmpty(_statusFilter))
                {
                    var statusMatch = _statusFilter switch
                    {
                        "Completed" => a.Status == ReportStatus.Completed,
                        "InProgress" => a.Status == ReportStatus.InProgress,
                        "Failed" => a.Status == ReportStatus.Failed,
                        _ => true
                    };
                    if (!statusMatch) return false;
                }

                return true;
            })
            .ToList();
    }

    private async Task RenderCharts()
    {
        try
        {
            // Daily trend chart
            var dailyData = _filteredAnalyses
                .GroupBy(a => a.CreatedAt.Date)
                .OrderBy(g => g.Key)
                .ToList();

            var dailyChartData = new
            {
                chartType = "LineChart",
                xAxis = new { labels = dailyData.Select(g => g.Key.ToString("MMM dd")).ToArray() },
                series = new[]
                {
                    new { name = "Analyses", values = dailyData.Select(g => g.Count()).ToArray() }
                }
            };

            await JS.InvokeVoidAsync("renderDashboardChart", "dailyAnalysisChart", dailyChartData);

            // Hourly distribution chart
            var hourlyData = Enumerable.Range(0, 24)
                .Select(h => new
                {
                    Hour = h,
                    Count = _filteredAnalyses.Count(a => a.CreatedAt.ToLocalTime().Hour == h)
                })
                .ToList();

            var hourlyChartData = new
            {
                chartType = "BarChart",
                xAxis = new { labels = hourlyData.Select(h => $"{h.Hour:00}:00").ToArray() },
                series = new[]
                {
                    new { name = "Analyses", values = hourlyData.Select(h => h.Count).ToArray() }
                }
            };

            await JS.InvokeVoidAsync("renderDashboardChart", "hourlyChart", hourlyChartData);

            // Status pie chart
            var statusData = new[]
            {
                _filteredAnalyses.Count(a => a.Status == ReportStatus.Completed),
                _filteredAnalyses.Count(a => a.Status == ReportStatus.InProgress),
                _filteredAnalyses.Count(a => a.Status == ReportStatus.Failed)
            };

            var statusChartData = new
            {
                chartType = "PieChart",
                xAxis = new { labels = new[] { "Completed", "In Progress", "Failed" } },
                series = new[]
                {
                    new { name = "Status", values = statusData }
                }
            };

            await JS.InvokeVoidAsync("renderDashboardChart", "statusPieChart", statusChartData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart render failed: {ex.Message}");
        }
    }

    private void ShowDetailModal(string type)
    {
        _detailModalTitle = type;
        _detailModalItems = type switch
        {
            "Total" => _analyses.OrderByDescending(a => a.CreatedAt).Take(50).ToList(),
            "Completed" => _analyses.Where(a => a.Status == ReportStatus.Completed).OrderByDescending(a => a.CreatedAt).Take(50).ToList(),
            "InProgress" => _analyses.Where(a => a.Status == ReportStatus.InProgress).OrderByDescending(a => a.CreatedAt).Take(50).ToList(),
            "Failed" => _analyses.Where(a => a.Status == ReportStatus.Failed).OrderByDescending(a => a.CreatedAt).Take(50).ToList(),
            _ => new()
        };
        _showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
    }

    private void ViewReport(Guid reportId)
    {
        Navigation.NavigateTo($"/reports/{reportId}");
    }

    public async ValueTask DisposeAsync()
    {
        _reportStatusChangedSubscription?.Dispose();
    }
}
