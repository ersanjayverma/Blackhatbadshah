@page "/logs"
@using Microsoft.AspNetCore.Components.Authorization
@using shared.Dto
@inject frontend.Services.LogService LogsApi
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>

        <h3>Logs</h3>

        <InputFile OnChange="OnFileSelected" />

        @if (_loading)
        {
            <p>Loading…</p>
        }
        else if (_logs.Count == 0)
        {
            <p>No logs uploaded yet.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size (KB)</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td>@log.FileName</td>
                            <td>@(log.SizeBytes / 1024)</td>
                            <td>@log.CreatedAt.ToLocalTime()</td>
                            <td>
                            
                                <button class="btn btn-sm btn-outline-success ms-2"
                                        @onclick="() => Analyze(log.Id)">
                                    Run Analysis
                                </button>
                        
                                <button class="btn btn-sm btn-outline-primary ms-2"
                                        @onclick="() => ViewInline(log)">
                                    See Content
                                </button>
                         
                                <button class="btn btn-sm btn-outline-danger ms-2"
                                        @onclick="() => Delete(log.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </Authorized>

    <NotAuthorized>
        <p>You must be logged in to access logs.</p>
    </NotAuthorized>
</AuthorizeView>

<!-- INLINE VIEWER MODAL -->
@if (_showContent)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_activeLogName</h5>
                    <button class="btn-close" @onclick="CloseViewer"></button>
                </div>
                <div class="modal-body">
                    <div style="max-height:70vh; overflow:auto">
                        @_logContent
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LogDto> _logs = new();
    private bool _loading = true;

    // Inline viewer state
    private bool _showContent;
    private MarkupString _logContent = new MarkupString("");
    private string _activeLogName = "";


    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        try
        {
            _loading = true;
            _logs = await LogsApi.ListAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _loading = false;
        }
    }
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // ---------------------------------------
        // 1. Size check (2 MB max)
        // ---------------------------------------
        const long maxSize = 2 * 1024 * 1024; // 2 MB

        if (file.Size > maxSize)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "File size exceeds 2 MB limit."
            );
            return;
        }

        // ---------------------------------------
        // 2. Extension check (.txt, .log only)
        // ---------------------------------------
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (extension != ".txt" && extension != ".log"&& extension != ".conf" &&  extension != ".config")
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Only .conf, .config, .txt and .log files are allowed."
            );
            return;
        }

        // ---------------------------------------
        // 3. Upload
        // ---------------------------------------
        await using var stream =
            file.OpenReadStream(maxAllowedSize: maxSize);

        await LogsApi.UploadAsync(
            stream,
            file.Name,
            "text/plain"
        );

        await Reload();
    }

    private string ConvertToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;
        
        // Use AdvancedExtensions for tables, task lists, etc.
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
            
        return Markdown.ToHtml(markdown, pipeline);
    }
    private async Task ViewInline(LogDto log)
    {
        // Guard: don't inline huge logs
        if (log.SizeBytes > 200 * 1024)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Log is too large to view inline. Use View or Download."
            );
            return;
        }

        _activeLogName = log.FileName;
        var markdown = await LogsApi.GetContentAsync(log.Id);
        var html = ConvertToHtml(markdown);

        _logContent = new MarkupString(html);
        _showContent = true;
    }

    private void CloseViewer()
    {
        _showContent = false;
        _logContent = new MarkupString("");
        _activeLogName = "";
    }

    private async Task Delete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this log?"
        );

        if (!confirmed)
            return;

        await LogsApi.DeleteAsync(id);
        await Reload();
    }
    private async Task Analyze(Guid Id){
          var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to Send this log for Analysis?"
        );
        if (!confirmed)
            return;
        var chat=  await LogsApi.AnalyzeAsync(Id);
        var html = ConvertToHtml(chat.reply);

        _logContent = new MarkupString(html);
        _activeLogName = "Analysis Result";
        _showContent = true;
    }
}
