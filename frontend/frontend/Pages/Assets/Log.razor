@page "/logs"
@using Microsoft.AspNetCore.Components.Authorization
@using shared.Dto
@using Markdig
@using frontend.Services
@inject LogService LogsApi
@inject HubConnectionService HubService
@inject IJSRuntime JS
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>

        <div class="container-fluid px-4 py-3">

            @* Header Section *@
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-file-earmark-text me-2"></i>Log Management
                    </h2>
                    <p class="text-muted mb-0">Upload, analyze, and manage your log files</p>
                </div>
                @if (_logs.Count > 0)
                {
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAll">
                        <i class="bi bi-trash me-1"></i>Clear All Logs
                    </button>
                }
            </div>

            @* Upload Section *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cloud-upload me-2"></i>Upload Logs
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @* File Upload *@
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="bi bi-file-earmark-arrow-up me-1"></i>Upload Log File
                            </label>
                            <div class="upload-zone p-4 border border-2 border-dashed rounded text-center">
                                <InputFile class="form-control"
                                           OnChange="OnFileSelected"
                                           accept=".txt,.log,.json,.xml,.csv,.png,.jpg,.jpeg,.tiff,.pdf" />
                                <div class="mt-3 text-muted">
                                    <i class="bi bi-file-earmark-plus fs-1 d-block mb-2"></i>
                                    <small>
                                        Supported formats: .txt, .log, .json, .xml, .csv, .pdf, images<br/>
                                        Maximum size: 10 MB
                                    </small>
                                </div>
                            </div>
                        </div>

                        @* Paste Logs *@
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="bi bi-clipboard me-1"></i>Or Paste Logs
                            </label>
                            <textarea class="form-control"
                                      rows="8"
                                      placeholder="Paste your log content here..."
                                      @bind="_pastedLogs"
                                      style="font-family: 'Courier New', monospace; font-size: 0.9rem;">
                            </textarea>
                            <button class="btn btn-primary mt-2 w-100"
                                    disabled="@string.IsNullOrWhiteSpace(_pastedLogs)"
                                    @onclick="UploadPastedLogs">
                                <i class="bi bi-upload me-1"></i>Upload Pasted Logs
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Logs List Section *@
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>Your Logs (@_logs.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (_loading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 text-muted">Loading logs...</p>
                        </div>
                    }
                    else if (_logs.Count == 0)
                    {
                        <div class="alert alert-info m-3">
                            <i class="bi bi-info-circle me-2"></i>
                            No logs uploaded yet. Upload your first log file to get started.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="bi bi-file-earmark me-1"></i>File Name</th>
                                        <th><i class="bi bi-hdd me-1"></i>Size</th>
                                        <th><i class="bi bi-calendar me-1"></i>Created</th>
                                        <th class="text-center"><i class="bi bi-gear me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in _logs)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                                                <strong>@log.FileName</strong>
                                            </td>
                                            <td class="align-middle">
                                                <span class="badge bg-secondary">
                                                    @FormatFileSize(log.SizeBytes)
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                @log.CreatedAt.ToLocalTime().ToString("g")
                                            </td>
                                            <td class="align-middle text-center">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-success"
                                                            @onclick="() => Analyze(log.Id)"
                                                            title="Analyze this log">
                                                        <i class="bi bi-search me-1"></i>Analyze
                                                    </button>
                                                    <button class="btn btn-sm btn-info"
                                                            @onclick="() => ViewInline(log)"
                                                            title="View log content">
                                                        <i class="bi bi-eye me-1"></i>View
                                                    </button>
                                                    <button class="btn btn-sm btn-danger"
                                                            @onclick="() => ConfirmDelete(log.Id, log.FileName)"
                                                            title="Delete this log">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>

        @* ================= LOG/ANALYSIS VIEWER MODAL ================= *@
        @if (_showContent)
        {
            <div class="modal-backdrop show"></div>
            <div class="modal show d-block">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header bg-dark text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-file-earmark-text me-2"></i>@_activeLogName
                            </h5>
                            <button class="btn-close btn-close-white" @onclick="CloseViewer"></button>
                        </div>
                        <div class="modal-body">
                            <div style="max-height:70vh; overflow:auto; padding: 20px; background-color: #f8f9fa;">
                                @_logContent
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CloseViewer">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ================= DELETE CONFIRMATION MODAL ================= *@
        @if (_showDeleteConfirm)
        {
            <div class="modal-backdrop show"></div>
            <div class="modal show d-block">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion
                            </h5>
                            <button class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete this log?</p>
                            <p class="fw-bold">@_logToDeleteName</p>
                            <p class="text-muted">This action cannot be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                            <button class="btn btn-danger" @onclick="DeleteLog">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ================= DELETE ALL CONFIRMATION MODAL ================= *@
        @if (_showDeleteAllConfirm)
        {
            <div class="modal-backdrop show"></div>
            <div class="modal show d-block">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-exclamation-triangle me-2"></i>Clear All Logs
                            </h5>
                            <button class="btn-close btn-close-white" @onclick="CancelDeleteAll"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete <strong>all @_logs.Count logs</strong>?</p>
                            <p class="text-danger fw-bold">This action cannot be undone!</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="CancelDeleteAll">Cancel</button>
                            <button class="btn btn-danger" @onclick="DeleteAllLogs">
                                <i class="bi bi-trash me-1"></i>Delete All
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>

    <NotAuthorized>
        <div class="container mt-5">
            <div class="alert alert-warning">
                <i class="bi bi-lock me-2"></i>
                You must be logged in to access logs.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .upload-zone {
        background-color: #f8f9fa;
        transition: all 0.3s ease;
    }

    .upload-zone:hover {
        background-color: #e9ecef;
        border-color: #0d6efd !important;
    }
</style>

@code {
    private List<LogDto> _logs = new();
    private bool _loading = true;
    private bool _showContent = false;
    private bool _showDeleteConfirm = false;
    private bool _showDeleteAllConfirm = false;

    private MarkupString _logContent = new("");
    private string _activeLogName = "";
    private string _pastedLogs = string.Empty;

    private Guid _logToDeleteId = Guid.Empty;
    private string _logToDeleteName = string.Empty;

    private IDisposable? _logCreatedSubscription;
    private IDisposable? _logDeletedSubscription;
    private IDisposable? _allLogsDeletedSubscription;

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".txt", ".log", ".json", ".xml", ".csv",
            ".png", ".jpg", ".jpeg", ".tiff",
            ".pdf"
        };

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            await HubService.InitializeAsync();
            await HubService.StartAsync();

            // Subscribe to real-time log events
            _logCreatedSubscription = HubService.On<LogDto>("LogCreated", async (log) =>
            {
                _logs.Insert(0, log);
                await InvokeAsync(StateHasChanged);
            });

            _logDeletedSubscription = HubService.On<Guid>("LogDeleted", async (logId) =>
            {
                _logs.RemoveAll(l => l.Id == logId);
                await InvokeAsync(StateHasChanged);
            });

            _allLogsDeletedSubscription = HubService.On("AllLogsDeleted", async () =>
            {
                _logs.Clear();
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection failed: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _logCreatedSubscription?.Dispose();
        _logDeletedSubscription?.Dispose();
        _allLogsDeletedSubscription?.Dispose();
    }

    private async Task Reload()
    {
        try
        {
            _loading = true;
            _logs = await LogsApi.ListAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        const long maxSize = 10 * 1024 * 1024;

        if (file.Size == 0 || file.Size > maxSize)
        {
            await JS.InvokeVoidAsync("alert", "Invalid file size. Maximum allowed is 10 MB.");
            return;
        }

        var extension = Path.GetExtension(file.Name);

        if (string.IsNullOrWhiteSpace(extension) || !AllowedExtensions.Contains(extension))
        {
            await JS.InvokeVoidAsync("alert", "Unsupported file type. Please upload a valid log file.");
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: maxSize);
            await LogsApi.UploadAsync(stream, file.Name, file.ContentType);
            await Reload();
            await JS.InvokeVoidAsync("alert", "Log file uploaded successfully!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Upload failed: {ex.Message}");
        }
    }

    private async Task UploadPastedLogs()
    {
        try
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(_pastedLogs);
            await using var stream = new MemoryStream(bytes);

            var fileName = $"pasted-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.log";

            await LogsApi.UploadAsync(stream, fileName, "text/plain");

            _pastedLogs = string.Empty;
            await Reload();
            await JS.InvokeVoidAsync("alert", "Pasted logs uploaded successfully!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Upload failed: {ex.Message}");
        }
    }

    private async Task ViewInline(LogDto log)
    {
        if (log.SizeBytes > 200 * 1024)
        {
            await JS.InvokeVoidAsync("alert", "Log is too large to view inline. Please use the download feature.");
            return;
        }

        try
        {
            _activeLogName = log.FileName;
            var content = await LogsApi.GetContentAsync(log.Id);
            var html = ConvertToHtml(content);

            _logContent = new MarkupString(html);
            _showContent = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to load log: {ex.Message}");
        }
    }

    private void CloseViewer()
    {
        _showContent = false;
        _logContent = new("");
        _activeLogName = "";
    }

    private void ConfirmDelete(Guid id, string fileName)
    {
        _logToDeleteId = id;
        _logToDeleteName = fileName;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _logToDeleteId = Guid.Empty;
        _logToDeleteName = string.Empty;
        _showDeleteConfirm = false;
    }

    private async Task DeleteLog()
    {
        try
        {
            await LogsApi.DeleteAsync(_logToDeleteId);
            await Reload();
            CancelDelete();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Delete failed: {ex.Message}");
        }
    }

    private void ConfirmDeleteAll()
    {
        _showDeleteAllConfirm = true;
    }

    private void CancelDeleteAll()
    {
        _showDeleteAllConfirm = false;
    }

    private async Task DeleteAllLogs()
    {
        try
        {
            var count = await LogsApi.DeleteAllAsync();
            _logs.Clear();
            _showDeleteAllConfirm = false;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Delete all failed: {ex.Message}");
        }
    }

    private async Task Analyze(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Send this log for AI analysis? This may take a few moments."
        );

        if (!confirmed)
            return;

        try
        {
            var chat = await LogsApi.AnalyzeAsync(id);
            var html = ConvertToHtml(chat.reply);

            _logContent = new MarkupString(html);
            _activeLogName = "Analysis Result";
            _showContent = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Analysis failed: {ex.Message}");
        }
    }

    private string ConvertToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()  // Disable raw HTML for XSS protection
            .Build();

        return Markdown.ToHtml(markdown, pipeline);
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024:F1} KB";
        return $"{bytes / (1024 * 1024):F1} MB";
    }
}
