@page "/logs"
@using Microsoft.AspNetCore.Components.Authorization
@using shared.Dto
@using Markdig
@inject frontend.Services.LogService LogsApi
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>

        <h3>Logs</h3>

        @if (_loading)
        {
            <p>Loading…</p>
        }
        else if (_logs.Count == 0)
        {
            <p>No logs uploaded yet.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size (KB)</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs)
                    {
                        <tr>
                            <td>@log.FileName</td>
                            <td>@(log.SizeBytes / 1024)</td>
                            <td>@log.CreatedAt.ToLocalTime()</td>
                            <td>
                                <button class="btn btn-sm btn-outline-success ms-2"
                                        @onclick="() => Analyze(log.Id)">
                                    Run Analysis
                                </button>

                                <button class="btn btn-sm btn-outline-primary ms-2"
                                        @onclick="() => ViewInline(log)">
                                    See Content
                                </button>

                                <button class="btn btn-sm btn-outline-danger ms-2"
                                        @onclick="() => Delete(log.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <hr />

        <h5>Upload or Paste Logs</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Upload Log File</label>
                <InputFile class="form-control"
                           OnChange="OnFileSelected" />
            </div>

            <div class="col-md-8">
                <label class="form-label">Paste Logs</label>
                <textarea class="form-control"
                          rows="8"
                          placeholder="Paste logs here..."
                          @bind="_pastedLogs">
                </textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(_pastedLogs)"
                    @onclick="UploadPastedLogs">
                Upload Pasted Logs
            </button>
        </div>

    </Authorized>

    <NotAuthorized>
        <p>You must be logged in to access logs.</p>
    </NotAuthorized>
</AuthorizeView>

@if (_showContent)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_activeLogName</h5>
                    <button class="btn-close" @onclick="CloseViewer"></button>
                </div>
                <div class="modal-body">
                    <div style="max-height:70vh; overflow:auto">
                        @_logContent
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LogDto> _logs = new();
    private bool _loading = true;

    private bool _showContent;
    private MarkupString _logContent = new("");
    private string _activeLogName = "";

    private string _pastedLogs = string.Empty;
    private Guid? _lastUploadedLogId;

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ".txt", ".log", ".json", ".xml", ".csv",
            ".png", ".jpg", ".jpeg", ".tiff",
            ".pdf"
        };

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        try
        {
            _loading = true;
            _logs = await LogsApi.ListAsync();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        const long maxSize = 10 * 1024 * 1024;

        if (file.Size == 0 || file.Size > maxSize)
        {
            await JS.InvokeVoidAsync("alert", "Invalid file size. Maximum allowed is 10 MB.");
            return;
        }

        var extension = Path.GetExtension(file.Name);

        if (string.IsNullOrWhiteSpace(extension) || !AllowedExtensions.Contains(extension))
        {
            await JS.InvokeVoidAsync("alert", "Unsupported or unsafe file type.");
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: maxSize);

        await LogsApi.UploadAsync(stream, file.Name, file.ContentType);

        await Reload();

        _lastUploadedLogId = _logs
            .OrderByDescending(l => l.CreatedAt)
            .FirstOrDefault()?.Id;
    }

    private async Task UploadPastedLogs()
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(_pastedLogs);
        await using var stream = new MemoryStream(bytes);

        var fileName = $"pasted-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.log";

        await LogsApi.UploadAsync(stream, fileName, "text/plain");

        _pastedLogs = string.Empty;

        await Reload();

        _lastUploadedLogId = _logs
            .OrderByDescending(l => l.CreatedAt)
            .FirstOrDefault()?.Id;
    }

    private string ConvertToHtml(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        return Markdown.ToHtml(markdown, pipeline);
    }

    private async Task ViewInline(LogDto log)
    {
        if (log.SizeBytes > 200 * 1024)
        {
            await JS.InvokeVoidAsync("alert", "Log is too large to view inline.");
            return;
        }

        _activeLogName = log.FileName;
        var markdown = await LogsApi.GetContentAsync(log.Id);
        var html = ConvertToHtml(markdown);

        _logContent = new MarkupString(html);
        _showContent = true;
    }

    private void CloseViewer()
    {
        _showContent = false;
        _logContent = new("");
        _activeLogName = "";
    }

    private async Task Delete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this log?"
        );

        if (!confirmed)
            return;

        await LogsApi.DeleteAsync(id);
        await Reload();
    }

    private async Task Analyze(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to Send this log for Analysis?"
        );

        if (!confirmed)
            return;

        var chat = await LogsApi.AnalyzeAsync(id);
        var html = ConvertToHtml(chat.reply);

        _logContent = new MarkupString(html);
        _activeLogName = "Analysis Result";
        _showContent = true;
    }
}
