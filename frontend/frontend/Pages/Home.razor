@code{
    public string HealthStatus = "";

    public async Task checkHealth(){
        var response  = await Http.GetFromJsonAsync<HealthResponse>("api/health");
        if (response != null)
        {
            HealthStatus = response.Status;
        }
        await InvokeAsync(StateHasChanged);
    }
}