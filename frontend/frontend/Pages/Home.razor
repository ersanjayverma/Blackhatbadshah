@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
<PageTitle>BlackHatBadshah - AI-Powered Log Analysis</PageTitle>

<section id="hero-section">
    <div class="contact-info-top">
        <div class="contact-item-inline">
            <i class="bi bi-envelope"></i>
            <a href="mailto:admin@blackhatbadshah.com">admin@blackhatbadshah.com</a>
        </div>
        <div class="contact-item-inline">
            <i class="bi bi-telephone"></i>
            <a href="tel:+918580400366">+91 8580 400 366</a>
        </div>
    </div>

    <h1>
        Diagnose invisible failures.<br />
        <span>Fix what's actually costing you money.</span>
    </h1>

    <p id="hero-subtitle">
        Upload logs, headers, or system data.
        We perform AI-assisted root-cause analysis and return
        actionable, engineering-grade fixes.
    </p>
    
    <AuthorizeView>
        <Authorized>
            <div id="hero-actions">
                <a class="btn-primary" href="/log-center">
                    <i class="bi bi-play-circle me-2"></i>Run an Audit
                </a>
                <a class="btn-secondary" href="/analysis">
                    <i class="bi bi-speedometer2 me-2"></i>View Dashboard
                </a>
            </div>
        </Authorized>
        <NotAuthorized>
            <div id="hero-actions">
                <a class="btn-primary" href="/login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Get Started Free
                </a>
                <a class="btn-secondary" href="/pricing">
                    <i class="bi bi-tag me-2"></i>View Pricing
                </a>
            </div>
            <p class="mt-3 text-muted small">
                <i class="bi bi-shield-check me-1"></i>
                No credit card required • 5 free analyses per month
            </p>
        </NotAuthorized>
    </AuthorizeView>
</section>

<section id="features-section">
    <div class="feature">
        <div class="feature-icon">
            <i class="bi bi-search"></i>
        </div>
        <h3>Root Cause, Not Symptoms</h3>
        <p>
            We correlate signals across systems and explain
            why failures happen — not just what broke.
        </p>
    </div>

    <div class="feature">
        <div class="feature-icon">
            <i class="bi bi-cpu"></i>
        </div>
        <h3>Production-Grade Analysis</h3>
        <p>
            Designed for real infrastructure, real logs,
            and real operational constraints.
        </p>
    </div>

    <div class="feature">
        <div class="feature-icon">
            <i class="bi bi-lightning-charge"></i>
        </div>
        <h3>Actionable Fixes</h3>
        <p>
            Clear, prioritized remediation steps you can
            implement immediately.
        </p>
    </div>
</section>

<!-- HOW IT WORKS SECTION -->
<section id="how-it-works" class="py-5">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">How It Works</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card text-center">
                    <div class="step-number">1</div>
                    <h4>Upload Your Logs</h4>
                    <p class="text-muted">
                        Upload log files, screenshots, or connect workers to stream logs in real-time.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card text-center">
                    <div class="step-number">2</div>
                    <h4>AI Analysis</h4>
                    <p class="text-muted">
                        Our AI models analyze your logs to identify issues, patterns, and root causes.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card text-center">
                    <div class="step-number">3</div>
                    <h4>Get Actionable Report</h4>
                    <p class="text-muted">
                        Receive a detailed report with prioritized fixes you can implement immediately.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TRUST INDICATORS -->
<section id="trust-section" class="py-4">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="trust-stat">
                    <h3 class="fw-bold text-gradient">10K+</h3>
                    <p class="text-muted mb-0">Logs Analyzed</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="trust-stat">
                    <h3 class="fw-bold text-gradient">99.9%</h3>
                    <p class="text-muted mb-0">Uptime</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="trust-stat">
                    <h3 class="fw-bold text-gradient">&lt; 30s</h3>
                    <p class="text-muted mb-0">Avg. Analysis Time</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="trust-stat">
                    <h3 class="fw-bold text-gradient">24/7</h3>
                    <p class="text-muted mb-0">Monitoring Ready</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .feature-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--accent) 0%, #f59e0b 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    
    .feature-icon i {
        font-size: 1.5rem;
        color: white;
    }
    
    #how-it-works {
        background: var(--surface);
        border-radius: 16px;
        margin: 2rem 0;
    }
    
    .step-card {
        padding: 2rem;
    }
    
    .step-number {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent) 0%, #f59e0b 100%);
        color: white;
        font-size: 1.25rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    
    .trust-stat h3 {
        font-size: 2rem;
        margin-bottom: 0.25rem;
    }
    
    #trust-section {
        margin-top: 2rem;
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Optional: Check API health on load
        try
        {
            var response = await Http.GetFromJsonAsync<HealthResponse>("api/health");
            // Could show a status indicator if needed
        }
        catch
        {
            // Silently fail - don't block page load
        }
    }
}