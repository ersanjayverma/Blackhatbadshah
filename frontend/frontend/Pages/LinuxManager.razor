    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        int order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    // Helper method to handle file/directory clicks
    private async Task HandleFileEntryClick(FileSystemEntry entry)
    {
        if (entry.Type == "directory")
        {
            await LoadDirectory(entry.FullPath);
        }
        else
        {
            await ViewFile(entry.FullPath);
        }
    }

    // Helper method to handle terminal keypress
    private async Task HandleTerminalKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteCommand();
        }
    }

    // Helper methods for service actions
    private Task RestartService(string serviceName) => ControlService(serviceName, "restart");
    private Task StopService(string serviceName) => ControlService(serviceName, "stop");
    private Task StartService(string serviceName) => ControlService(serviceName, "start");

    // Helper methods for container actions
    private Task RestartContainer(string containerId) => ControlContainer(containerId, "restart");
    private Task StopContainer(string containerId) => ControlContainer(containerId, "stop");
    private Task StartContainer(string containerId) => ControlContainer(containerId, "start");
    private Task RemoveContainer(string containerId) => ControlContainer(containerId, "remove");
}
