    private RenderFragment RenderTerminalTab() => @<div>
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-terminal me-2"></i>Remote Terminal</h5>
            </div>
            <div class="card-body bg-dark text-light" style="min-height: 400px;">
                <!-- Command Output -->
                <div style="max-height: 350px; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.9em;" class="mb-3">
                    @foreach (var cmd in CommandHistory)
                    {
                        <div class="mb-3">
                            <div class="text-success">$ @cmd.Command</div>
                            @if (!string.IsNullOrEmpty(cmd.StdOut))
                            {
                                <pre class="text-light mb-0" style="white-space: pre-wrap;">@cmd.StdOut</pre>
                            }
                            @if (!string.IsNullOrEmpty(cmd.StdErr))
                            {
                                <pre class="text-danger mb-0" style="white-space: pre-wrap;">@cmd.StdErr</pre>
                            }
                            <small class="text-muted">Exit code: @cmd.ExitCode | Time: @cmd.ExecutionTimeMs ms</small>
                        </div>
                    }
                </div>

                <!-- Command Input -->
                <div class="input-group">
                    <span class="input-group-text bg-secondary text-light border-secondary">$</span>
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           @bind="TerminalCommand" @bind:event="oninput"
                           @onkeypress="HandleTerminalKeyPress"
                           placeholder="Enter command..." />
                    <div class="input-group-text bg-secondary border-secondary">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" @bind="RunAsRoot" id="runAsRoot">
                            <label class="form-check-label text-light" for="runAsRoot">sudo</label>
                        </div>
                    </div>
                    <button class="btn btn-success" @onclick="ExecuteCommand">
                        <i class="bi bi-play-fill"></i>
                    </button>
                </div>
            </div>
            <div class="card-footer bg-dark text-muted small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Some commands are blocked for security. Use with caution.
            </div>
        </div>
    </div>;

