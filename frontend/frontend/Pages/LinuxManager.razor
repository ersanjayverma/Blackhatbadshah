@page "/linux-manager"
@page "/linux-manager/{WorkerId}"
@using Microsoft.AspNetCore.Authorization
@using frontend.Services
@using shared.Dto
@inject LinuxSystemService LinuxService
@inject WorkerAgentService WorkerAgentService
@inject NavigationManager Nav
@attribute [Authorize]

<PageTitle>Linux System Manager - BlackHatBadshah</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-terminal me-2"></i>Linux System Manager</h2>
            <p class="text-muted mb-0">Enterprise Linux server management & monitoring</p>
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(SelectedWorkerId))
            {
                <button class="btn btn-outline-primary" @onclick="RefreshAll">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            }
        </div>
    </div>

    @if (Workers == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading workers...</span>
            </div>
        </div>
    }
    else if (!Workers.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No workers available. Register a worker to start managing your Linux systems.
        </div>
    }
    else
    {
        <!-- Worker Selection -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Select Worker</label>
                        <select class="form-select" @bind="SelectedWorkerId" @bind:after="OnWorkerSelected">
                            <option value="">-- Select a worker --</option>
                            @foreach (var worker in Workers)
                            {
                                <option value="@worker.Id">@worker.Name (@worker.Hostname)</option>
                            }
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(SelectedWorkerId) && SecurityAudit != null)
                    {
                        <div class="col-md-8">
                            <div class="d-flex gap-4 justify-content-end">
                                <div class="text-center">
                                    <div class="fs-3 fw-bold @GetSecurityScoreClass(SecurityAudit.SecurityScore)">
                                        @SecurityAudit.SecurityScore/100
                                    </div>
                                    <small class="text-muted">Security Score</small>
                                </div>
                                <div class="text-center">
                                    <div class="fs-3 fw-bold">@(SshSessions?.ActiveCount ?? 0)</div>
                                    <small class="text-muted">SSH Sessions</small>
                                </div>
                                <div class="text-center">
                                    <div class="fs-3 fw-bold">@(Containers?.RunningCount ?? 0)</div>
                                    <small class="text-muted">Containers</small>
                                </div>
                                <div class="text-center">
                                    <div class="fs-3 fw-bold">@(Services?.RunningCount ?? 0)</div>
                                    <small class="text-muted">Services</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(SelectedWorkerId))
        {
            <!-- Tab Navigation -->
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "security" ? "active" : "")" @onclick='() => ActiveTab = "security"'>
                        <i class="bi bi-shield-check me-1"></i>Security
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "services" ? "active" : "")" @onclick='() => ActiveTab = "services"'>
                        <i class="bi bi-gear me-1"></i>Services
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "docker" ? "active" : "")" @onclick='() => ActiveTab = "docker"'>
                        <i class="bi bi-box me-1"></i>Docker
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "files" ? "active" : "")" @onclick='() => ActiveTab = "files"'>
                        <i class="bi bi-folder me-1"></i>Files
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "users" ? "active" : "")" @onclick='() => ActiveTab = "users"'>
                        <i class="bi bi-people me-1"></i>Users
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "firewall" ? "active" : "")" @onclick='() => ActiveTab = "firewall"'>
                        <i class="bi bi-bricks me-1"></i>Firewall
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "terminal" ? "active" : "")" @onclick='() => ActiveTab = "terminal"'>
                        <i class="bi bi-terminal me-1"></i>Terminal
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "cron" ? "active" : "")" @onclick='() => ActiveTab = "cron"'>
                        <i class="bi bi-clock-history me-1"></i>Cron Jobs
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @switch (ActiveTab)
                {
                    case "security":
                        @RenderSecurityTab()
                        break;
                    case "services":
                        @RenderServicesTab()
                        break;
                    case "docker":
                        @RenderDockerTab()
                        break;
                    case "files":
                        @RenderFilesTab()
                        break;
                    case "users":
                        @RenderUsersTab()
                        break;
                    case "firewall":
                        @RenderFirewallTab()
                        break;
                    case "terminal":
                        @RenderTerminalTab()
                        break;
                    case "cron":
                        @RenderCronTab()
                        break;
                }
            }
        }
    }
</div>

@code {
    [Parameter] public string? WorkerId { get; set; }

    private List<WorkerAgentListItem>? Workers;
    private string SelectedWorkerId = "";
    private string ActiveTab = "security";
    private bool IsLoading = false;

    // Data
    private SecurityAuditInfo? SecurityAudit;
    private ServiceListResponse? Services;
    private ContainerListResponse? Containers;
    private UserListResponse? Users;
    private FirewallStatusResponse? Firewall;
    private SshSessionListResponse? SshSessions;
    private CronJobListResponse? CronJobs;
    private DirectoryListResponse? DirectoryListing;

    // File browser state
    private string CurrentPath = "/";
    private string? SelectedFilePath;
    private FileContentResponse? FileContent;

    // Terminal state
    private string TerminalCommand = "";
    private List<CommandExecutionResponse> CommandHistory = new();
    private bool RunAsRoot = false;

    // Service filter
    private string ServiceFilter = "";
    private bool ShowOnlyRunning = false;

    protected override async Task OnInitializedAsync()
    {
        Workers = await WorkerAgentService.GetAllAsync();

        if (!string.IsNullOrEmpty(WorkerId))
        {
            SelectedWorkerId = WorkerId;
            await OnWorkerSelected();
        }
    }

    private async Task OnWorkerSelected()
    {
        if (string.IsNullOrEmpty(SelectedWorkerId)) return;

        IsLoading = true;
        StateHasChanged();

        // Load all data in parallel
        var tasks = new List<Task>
        {
            LoadSecurityAudit(),
            LoadServices(),
            LoadContainers(),
            LoadSshSessions()
        };

        await Task.WhenAll(tasks);

        IsLoading = false;
        StateHasChanged();
    }

    private async Task RefreshAll()
    {
        await OnWorkerSelected();
    }

    private async Task LoadSecurityAudit()
    {
        SecurityAudit = await LinuxService.GetSecurityAuditAsync(SelectedWorkerId);
    }

    private async Task LoadServices()
    {
        Services = await LinuxService.GetServicesAsync(SelectedWorkerId);
    }

    private async Task LoadContainers()
    {
        Containers = await LinuxService.GetContainersAsync(SelectedWorkerId);
    }

    private async Task LoadUsers()
    {
        Users = await LinuxService.GetUsersAsync(SelectedWorkerId);
    }

    private async Task LoadFirewall()
    {
        Firewall = await LinuxService.GetFirewallStatusAsync(SelectedWorkerId);
    }

    private async Task LoadSshSessions()
    {
        SshSessions = await LinuxService.GetSshSessionsAsync(SelectedWorkerId);
    }

    private async Task LoadCronJobs()
    {
        CronJobs = await LinuxService.GetCronJobsAsync(SelectedWorkerId);
    }

    private async Task LoadDirectory(string path)
    {
        CurrentPath = path;
        DirectoryListing = await LinuxService.ListDirectoryAsync(SelectedWorkerId, path, true);
        FileContent = null;
        SelectedFilePath = null;
    }

    private async Task ViewFile(string filePath)
    {
        SelectedFilePath = filePath;
        FileContent = await LinuxService.ReadFileAsync(SelectedWorkerId, filePath, 1000);
    }

    private async Task ExecuteCommand()
    {
        if (string.IsNullOrWhiteSpace(TerminalCommand)) return;

        var response = await LinuxService.ExecuteCommandAsync(SelectedWorkerId, TerminalCommand, 60, RunAsRoot);
        if (response != null)
        {
            CommandHistory.Insert(0, response);
            if (CommandHistory.Count > 50) CommandHistory.RemoveAt(CommandHistory.Count - 1);
        }
        TerminalCommand = "";
    }

    private async Task ControlService(string serviceName, string action)
    {
        await LinuxService.ControlServiceAsync(SelectedWorkerId, serviceName, action);
        await LoadServices();
    }

    private async Task ControlContainer(string containerId, string action)
    {
        await LinuxService.ControlContainerAsync(SelectedWorkerId, containerId, action);
        await LoadContainers();
    }

    private string GetSecurityScoreClass(int score) => score switch
    {
        >= 80 => "text-success",
        >= 60 => "text-warning",
        _ => "text-danger"
    };

    private string GetSeverityClass(string severity) => severity.ToLower() switch
    {
        "critical" => "bg-danger",
        "high" => "bg-warning text-dark",
        "medium" => "bg-info",
        _ => "bg-secondary"
    };

    private IEnumerable<ServiceInfo> FilteredServices =>
        Services?.Services?
            .Where(s => string.IsNullOrEmpty(ServiceFilter) || s.Name.Contains(ServiceFilter, StringComparison.OrdinalIgnoreCase))
            .Where(s => !ShowOnlyRunning || s.IsActive)
            .OrderBy(s => s.Name) ?? Enumerable.Empty<ServiceInfo>();

    // ============================================================
    // RENDER METHODS
    // ============================================================

    private RenderFragment RenderSecurityTab() => @<div class="row g-4">
        <!-- Security Score Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Security Score</h5>
                    <div class="display-1 fw-bold @GetSecurityScoreClass(SecurityAudit?.SecurityScore ?? 0)">
                        @(SecurityAudit?.SecurityScore ?? 0)
                    </div>
                    <p class="text-muted">out of 100</p>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar @GetSecurityScoreClass(SecurityAudit?.SecurityScore ?? 0).Replace("text-", "bg-")"
                             style="width: @(SecurityAudit?.SecurityScore ?? 0)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-md-8">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Security Overview</h5>
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi @(SecurityAudit?.FirewallActive == true ? "bi-shield-check text-success" : "bi-shield-x text-danger") fs-3 me-2"></i>
                                <div>
                                    <small class="text-muted">Firewall</small>
                                    <div class="fw-semibold">@(SecurityAudit?.FirewallActive == true ? "Active" : "Inactive")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi @(SecurityAudit?.SshRootLoginEnabled == true ? "bi-exclamation-triangle text-warning" : "bi-check-circle text-success") fs-3 me-2"></i>
                                <div>
                                    <small class="text-muted">SSH Root</small>
                                    <div class="fw-semibold">@(SecurityAudit?.SshRootLoginEnabled == true ? "Enabled" : "Disabled")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-key fs-3 me-2 @(SecurityAudit?.SshPasswordAuthEnabled == true ? "text-warning" : "text-success")"></i>
                                <div>
                                    <small class="text-muted">SSH Password</small>
                                    <div class="fw-semibold">@(SecurityAudit?.SshPasswordAuthEnabled == true ? "Enabled" : "Disabled")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-hdd-network fs-3 me-2 text-info"></i>
                                <div>
                                    <small class="text-muted">Open Ports</small>
                                    <div class="fw-semibold">@(SecurityAudit?.OpenPorts ?? 0)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-x-circle fs-3 me-2 @(SecurityAudit?.FailedLoginAttempts24h > 100 ? "text-danger" : "text-success")"></i>
                                <div>
                                    <small class="text-muted">Failed Logins (24h)</small>
                                    <div class="fw-semibold">@(SecurityAudit?.FailedLoginAttempts24h ?? 0)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-arrow-repeat fs-3 me-2 @(SecurityAudit?.UnattendedUpgradesEnabled == true ? "text-success" : "text-warning")"></i>
                                <div>
                                    <small class="text-muted">Auto Updates</small>
                                    <div class="fw-semibold">@(SecurityAudit?.UnattendedUpgradesEnabled == true ? "Enabled" : "Disabled")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recommendations -->
        @if (SecurityAudit?.Recommendations?.Any() == true)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Security Recommendations</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var rec in SecurityAudit.Recommendations)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge @GetSeverityClass(rec.Severity) me-2">@rec.Severity.ToUpper()</span>
                                            <strong>@rec.Title</strong>
                                            <p class="mb-1 mt-1 text-muted">@rec.Description</p>
                                            <small class="text-primary"><i class="bi bi-wrench me-1"></i>@rec.Remediation</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- SSH Sessions -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-terminal me-2"></i>Active SSH Sessions</h5>
                    <span class="badge bg-primary">@(SshSessions?.ActiveCount ?? 0) active</span>
                </div>
                <div class="card-body">
                    @if (SshSessions?.Sessions?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Remote Host</th>
                                        <th>TTY</th>
                                        <th>PID</th>
                                        <th>Idle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in SshSessions.Sessions)
                                    {
                                        <tr>
                                            <td><i class="bi bi-person me-1"></i>@session.User</td>
                                            <td>@session.RemoteHost</td>
                                            <td>@session.Tty</td>
                                            <td>@session.Pid</td>
                                            <td>@session.IdleTime</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active SSH sessions</p>
                    }
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderServicesTab() => @<div>
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>System Services (systemctl)</h5>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" placeholder="Filter services..." @bind="ServiceFilter" @bind:event="oninput" />
                            <div class="form-check form-switch d-flex align-items-center">
                                <input class="form-check-input" type="checkbox" @bind="ShowOnlyRunning" id="showRunning">
                                <label class="form-check-label ms-2" for="showRunning">Running only</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Services?.Services?.Any() == true)
                {
                    <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                        <table class="table table-hover mb-0">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Service</th>
                                    <th>Status</th>
                                    <th>State</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var service in FilteredServices)
                                {
                                    <tr>
                                        <td class="fw-semibold">@service.Name</td>
                                        <td>
                                            @if (service.IsActive)
                                            {
                                                <span class="badge bg-success">running</span>
                                            }
                                            else if (service.Status == "failed")
                                            {
                                                <span class="badge bg-danger">failed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@service.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (service.IsEnabled)
                                            {
                                                <span class="text-success"><i class="bi bi-check-circle"></i> enabled</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="bi bi-x-circle"></i> disabled</span>
                                            }
                                        </td>
                                        <td class="text-truncate" style="max-width: 300px;">@service.Description</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                @if (service.IsActive)
                                                {
                                                    <button class="btn btn-outline-warning" @onclick="() => RestartService(service.Name)" title="Restart">
                                                        <i class="bi bi-arrow-clockwise"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => StopService(service.Name)" title="Stop">
                                                        <i class="bi bi-stop-fill"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-success" @onclick="() => StartService(service.Name)" title="Start">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No services found or failed to load services</p>
                }
            </div>
            <div class="card-footer bg-white">
                <small class="text-muted">
                    Showing @FilteredServices.Count() of @(Services?.TotalCount ?? 0) services
                    • @(Services?.RunningCount ?? 0) running
                    • @(Services?.FailedCount ?? 0) failed
                </small>
            </div>
        </div>
    </div>;

    private RenderFragment RenderDockerTab() => @<div>
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-box me-2"></i>Docker Containers</h5>
                @if (Containers?.DockerAvailable == true)
                {
                    <span class="badge bg-info">@Containers.DockerVersion</span>
                }
            </div>
            <div class="card-body">
                @if (Containers?.DockerAvailable != true)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Docker is not installed or not accessible on this worker.
                    </div>
                }
                else if (Containers?.Containers?.Any() == true)
                {
                    <div class="row g-3">
                        @foreach (var container in Containers.Containers)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 @(container.State == "running" ? "border-success" : "border-secondary")">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0">@container.Name</h6>
                                            <span class="badge @(container.State == "running" ? "bg-success" : "bg-secondary")">
                                                @container.State
                                            </span>
                                        </div>
                                        <p class="card-text small text-muted mb-2">
                                            <i class="bi bi-box-seam me-1"></i>@container.Image
                                        </p>
                                        @if (container.State == "running")
                                        {
                                            <div class="row g-2 mb-2 small">
                                                <div class="col-6">
                                                    <span class="text-muted">CPU:</span> @container.CpuPercent.ToString("F1")%
                                                </div>
                                                <div class="col-6">
                                                    <span class="text-muted">Memory:</span> @container.MemoryPercent.ToString("F1")%
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(container.Ports))
                                        {
                                            <p class="small mb-2"><i class="bi bi-hdd-network me-1"></i>@container.Ports</p>
                                        }
                                        <div class="btn-group btn-group-sm w-100">
                                            @if (container.State == "running")
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => RestartContainer(container.Id)">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => StopContainer(container.Id)">
                                                    <i class="bi bi-stop-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-success" @onclick="() => StartContainer(container.Id)">
                                                    <i class="bi bi-play-fill"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => RemoveContainer(container.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0">No containers found</p>
                }
            </div>
            @if (Containers?.DockerAvailable == true)
            {
                <div class="card-footer bg-white">
                    <small class="text-muted">
                        @Containers.TotalCount containers total
                        • @Containers.RunningCount running
                        • @Containers.StoppedCount stopped
                    </small>
                </div>
            }
        </div>
    </div>;

    private RenderFragment RenderFilesTab() => @<div>
        <div class="row g-4">
            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-folder me-2"></i>File Browser</h5>
                    </div>
                    <div class="card-body">
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-folder"></i></span>
                            <input type="text" class="form-control" @bind="CurrentPath" />
                            <button class="btn btn-primary" @onclick="() => LoadDirectory(CurrentPath)">Go</button>
                        </div>

                        @if (DirectoryListing == null)
                        {
                            <button class="btn btn-outline-primary w-100" @onclick="() => LoadDirectory(CurrentPath)">
                                <i class="bi bi-folder-symlink me-2"></i>Browse Files
                            </button>
                        }
                        else if (DirectoryListing.Success)
                        {
                            <div style="max-height: 500px; overflow-y: auto;">
                                @if (DirectoryListing.ParentPath != CurrentPath)
                                {
                                    <div class="list-group-item list-group-item-action" style="cursor: pointer" @onclick="() => LoadDirectory(DirectoryListing.ParentPath)">
                                        <i class="bi bi-arrow-up me-2"></i>..
                                    </div>
                                }
                                <div class="list-group list-group-flush">
                                    @foreach (var entry in DirectoryListing.Entries ?? new())
                                    {
                                        <div class="list-group-item list-group-item-action" style="cursor: pointer"
                                             @onclick="() => HandleFileEntryClick(entry)">
                                            <i class="bi @(entry.Type == "directory" ? "bi-folder text-warning" : "bi-file-text text-primary") me-2"></i>
                                            @entry.Name
                                            @if (entry.Type == "file")
                                            {
                                                <small class="text-muted ms-2">@FormatFileSize(entry.Size)</small>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="mt-2 small text-muted">
                                @DirectoryListing.DirectoryCount directories, @DirectoryListing.FileCount files
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0">@DirectoryListing.Error</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>File Content</h5>
                        @if (!string.IsNullOrEmpty(SelectedFilePath))
                        {
                            <small class="text-muted">@SelectedFilePath</small>
                        }
                    </div>
                    <div class="card-body">
                        @if (FileContent == null)
                        {
                            <p class="text-muted text-center">Select a file to view its contents</p>
                        }
                        else if (FileContent.Success)
                        {
                            @if (FileContent.IsBinary)
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-file-binary me-2"></i>
                                    Binary file - @FileContent.Content
                                </div>
                            }
                            else
                            {
                                <pre class="bg-dark text-light p-3 rounded" style="max-height: 500px; overflow: auto; font-size: 0.85em;">@FileContent.Content</pre>
                            }
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0">@FileContent.Error</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment RenderUsersTab() => @<div>
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>System Users</h5>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadUsers">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>
            <div class="card-body p-0">
                @if (Users == null)
                {
                    <div class="text-center py-4">
                        <button class="btn btn-primary" @onclick="LoadUsers">
                            <i class="bi bi-people me-2"></i>Load Users
                        </button>
                    </div>
                }
                else if (Users.Success && Users.Users?.Any() == true)
                {
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover mb-0">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>Username</th>
                                    <th>UID</th>
                                    <th>Home</th>
                                    <th>Shell</th>
                                    <th>Groups</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Users.Users.Where(u => !u.IsSystemUser))
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <i class="bi bi-person me-1"></i>@user.Username
                                            @if (!string.IsNullOrEmpty(user.FullName))
                                            {
                                                <small class="text-muted ms-1">(@user.FullName)</small>
                                            }
                                        </td>
                                        <td>@user.Uid</td>
                                        <td><code>@user.HomeDirectory</code></td>
                                        <td><code>@user.Shell</code></td>
                                        <td>
                                            @foreach (var group in user.Groups?.Take(3) ?? new List<string>())
                                            {
                                                <span class="badge bg-secondary me-1">@group</span>
                                            }
                                            @if ((user.Groups?.Count ?? 0) > 3)
                                            {
                                                <span class="text-muted">+@(user.Groups!.Count - 3) more</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.IsLocked)
                                            {
                                                <span class="badge bg-danger">Locked</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">@(Users?.Error ?? "No users found")</p>
                }
            </div>
            @if (Users != null)
            {
                <div class="card-footer bg-white">
                    <small class="text-muted">
                        @Users.TotalCount users total
                        • @Users.HumanUserCount human users
                        • @Users.SystemUserCount system users
                    </small>
                </div>
            }
        </div>
    </div>;

