@page "/log-center"
@page "/logs"
@page "/livelogs"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.SignalR.Client
@using shared.Dto
@using Markdig
@using frontend.Services
@using Blazored.LocalStorage
@inject LogService LogsApi
@inject LiveLogService LiveLogApi
@inject WorkerService WorkerApi
@inject HubConnectionService HubService
@inject IAccessTokenProvider TokenProvider
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject ToastService Toast
@inject NavigationManager Navigation
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>
        <div class="container-fluid px-4 py-4">

            <!-- HEADER ROW -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Log Center</h4>
                <div class="d-flex gap-2 align-items-center">
                    @if (_isSubscribed)
                    {
                        <span class="badge bg-primary px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>Connected: @(_availableWorkers.FirstOrDefault(w => w.WorkerId == _subscribedWorkerId)?.Hostname ?? _subscribedWorkerId)
                        </span>
                    }
                    @if (_isStreaming)
                    {
                        <span class="badge bg-success px-3 py-2"><i class="bi bi-broadcast me-1"></i>Live</span>
                    }
                    <span class="badge bg-secondary px-3 py-2">@_availableWorkers.Count(w => w.IsOnline) Workers Online</span>
                </div>
            </div>

            <!-- CONTROLS ROW -->
            <div class="card modern-card shadow-sm mb-3">
                <div class="card-body py-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-cpu me-2"></i>AI Model</label>
                            <select class="form-select" @bind="_selectedModel">
                                <optgroup label="Claude (Anthropic)">
                                    <option value="claude-sonnet-4-5">Claude Sonnet 4.5 (Recommended)</option>
                                    <option value="claude-opus-4-5">Claude Opus 4.5 (Most Powerful)</option>
                                </optgroup>
                                <optgroup label="GPT (OpenAI)">
                                    <option value="gpt-4o">GPT-4o</option>
                                    <option value="gpt-4-turbo">GPT-4 Turbo</option>
                                </optgroup>
                                <optgroup label="Open Source">
                                    <option value="together-llama-3.1-405b">Llama 3.1 405B</option>
                                    <option value="together-mixtral-8x7b">Mixtral 8x7B</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold"><i class="bi bi-hdd-network me-2"></i>Worker Connection</label>
                            <div class="input-group">
                                <select class="form-select" @bind="_workerIdInput" disabled="@_isSubscribed">
                                    <option value="">Select a worker...</option>
                                    @foreach (var w in _availableWorkers)
                                    {
                                        <option value="@w.WorkerId">@w.Hostname @(w.IsOnline ? "(Online)" : "(Offline)")</option>
                                    }
                                </select>
                                <button class="btn btn-outline-secondary" @onclick="RefreshWorkers" disabled="@_loadingWorkers">
                                    @if (_loadingWorkers)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-clockwise me-1"></i><text>Refresh</text>
                                    }
                                </button>
                                @if (_isSubscribed)
                                {
                                    <button class="btn btn-outline-danger" @onclick="Unsubscribe">
                                        <i class="bi bi-x-circle me-1"></i>Disconnect
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary" @onclick="Subscribe" disabled="@string.IsNullOrWhiteSpace(_workerIdInput)">
                                        <i class="bi bi-link-45deg me-1"></i>Connect
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold"><i class="bi bi-broadcast me-2"></i>Live Streaming</label>
                            <div class="input-group">
                                <select class="form-select" @bind="_selectedLogPath" disabled="@(!_isSubscribed || _isStreaming)">
                                    <option value="">Select log path to stream...</option>
                                    @foreach (var p in _selectedWorkerLogPaths) { <option value="@p">@p</option> }
                                </select>
                                <button class="btn btn-success" @onclick="StartStream" disabled="@(!_isSubscribed || _isStreaming || string.IsNullOrWhiteSpace(_selectedLogPath))">
                                    <i class="bi bi-play-fill me-1"></i>Start
                                </button>
                                <button class="btn btn-outline-danger" @onclick="StopStream" disabled="@(!_isStreaming)">
                                    <i class="bi bi-stop-fill me-1"></i>Stop
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UPLOAD & PULL ROW -->
            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <div class="card modern-card shadow-sm h-100">
                        <div class="card-header py-2">
                            <span class="fw-bold"><i class="bi bi-cloud-upload me-2"></i>Upload Logs</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Upload File</label>
                                <InputFile OnChange="OnFileSelected" accept=".txt,.log,.json,.xml,.csv,.png,.jpg,.jpeg,.tiff,.pdf" class="form-control" />
                                <small class="text-muted">Max 2MB - .txt .log .json .xml .csv .pdf + images</small>
                            </div>
                            <div>
                                <label class="form-label">Or Paste Logs</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Paste log content here..." @bind="_pastedLogs" />
                                    <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_pastedLogs)" @onclick="UploadPastedLogs">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="card modern-card shadow-sm h-100">
                        <div class="card-header py-2">
                            <span class="fw-bold"><i class="bi bi-download me-2"></i>Pull Logs from Worker</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">Worker</label>
                                    <select class="form-select" @bind="_selectedPullWorkerId" disabled="@_pulling">
                                        <option value="">Select...</option>
                                        @foreach (var w in _availableWorkers.Where(w => w.IsOnline)) { <option value="@w.WorkerId">@w.Hostname</option> }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Log File</label>
                                    <select class="form-select" @bind="_pullLogPath" disabled="@(SelectedPullWorker == null || _pulling)">
                                        <option value="">Select...</option>
                                        @if (SelectedPullWorker != null) { @foreach (var p in SelectedPullWorker.AvailableLogPaths) { <option value="@p">@p</option> } }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Lines</label>
                                    <input type="number" class="form-control" @bind="_pullLines" min="10" max="1000" disabled="@_pulling" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">From</label>
                                    <select class="form-select" @bind="_pullFromEnd" disabled="@_pulling">
                                        <option value="@true">End (tail)</option>
                                        <option value="@false">Beginning</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    @if (_pulling)
                                    {
                                        <button class="btn btn-warning w-100" @onclick="CancelPullLogs">
                                            <span class="spinner-border spinner-border-sm me-1"></span>Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary w-100" @onclick="PullLogs" disabled="@(SelectedPullWorker == null || string.IsNullOrEmpty(_pullLogPath))">
                                            <i class="bi bi-download me-1"></i>Pull
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (_pulledLogs.Count > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-light rounded">
                                    <span class="fw-bold">Pulled @_pulledLogs.Count lines</span>
                                    <div class="btn-group">
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="CopyPulledLogs">
                                            <i class="bi bi-clipboard me-1"></i>Copy
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearPulledLogs">
                                            <i class="bi bi-x-lg me-1"></i>Clear
                                        </button>
                                        <button class="btn btn-primary btn-sm" @onclick="AnalyzePulledLogs" disabled="@_analyzingPulledLogs">
                                            <i class="bi bi-cpu me-1"></i>Analyze
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_pullError)) { <div class="alert alert-danger mt-2 mb-0 py-2">@_pullError</div> }
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAIN CONTENT: STREAM & LOGS -->
            <div class="row g-3">
                <!-- LIVE STREAM -->
                <div class="col-lg-7">
                    <div class="card modern-card shadow-sm">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold"><i class="bi bi-terminal me-2"></i>Live Stream (@FilteredLiveLogs.Count)</span>
                                @if (FilteredLiveLogs.Count > 0)
                                {
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="selectAllLogs" checked="@_selectAll" @onchange="OnSelectAllChanged" />
                                        <label class="form-check-label" for="selectAllLogs">Select All</label>
                                    </div>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm" style="width: 100px;" @bind="_filterLevel">
                                    <option value="">All Levels</option>
                                    <option value="ERROR">Error</option>
                                    <option value="WARN">Warning</option>
                                    <option value="INFO">Info</option>
                                </select>
                                <input type="text" class="form-control form-control-sm" style="width: 120px;" placeholder="Search..." @bind="_searchText" @bind:event="oninput" />
                                <button class="btn btn-success btn-sm" @onclick="AnalyzeSelected" disabled="@(_selectedLiveLogs.Count == 0 || _analyzing)">
                                    <i class="bi bi-cpu me-1"></i>Analyze (@_selectedLiveLogs.Count)
                                </button>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="autoScrollCheck" @bind="_autoScroll" />
                                    <label class="form-check-label" for="autoScrollCheck">Auto-scroll</label>
                                </div>
                                @if (_liveLogs.Count > 0)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearLiveLogs">
                                        <i class="bi bi-x-lg me-1"></i>Clear
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @if (_liveLogs.Count == 0)
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-broadcast display-4 text-muted d-block mb-2"></i>
                                    <p>Connect to a worker and start streaming to see logs</p>
                                </div>
                            }
                            else
                            {
                                <div class="log-stream-container" style="max-height: 450px;" @ref="_logContainer">
                                    <table class="table table-sm mb-0 log-table">
                                        <thead class="sticky-top bg-dark text-light">
                                            <tr>
                                                <th style="width: 30px;"></th>
                                                <th style="width: 70px;">Level</th>
                                                <th style="width: 80px;">Time</th>
                                                <th>Message</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var log in FilteredLiveLogs)
                                            {
                                                <tr class="@GetRowClass(log.Level)" @onclick="() => ToggleLiveLogSelection(log.Id)" style="cursor: pointer;">
                                                    <td><input type="checkbox" class="form-check-input" checked="@_selectedLiveLogs.Contains(log.Id)" @onclick:stopPropagation="true" @onchange="() => ToggleLiveLogSelection(log.Id)" /></td>
                                                    <td><span class="badge @GetLevelBadgeClass(log.Level)">@log.Level</span></td>
                                                    <td class="small">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                                    <td class="log-message-wrap">@log.Message</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="card-footer py-2 d-flex gap-4">
                            <span><strong>@_liveLogs.Count</strong> total</span>
                            <span class="text-danger"><strong>@_liveStats.ErrorCount</strong> errors</span>
                            <span class="text-warning"><strong>@_liveStats.WarningCount</strong> warnings</span>
                            <span class="text-info"><strong>@_liveStats.InfoCount</strong> info</span>
                        </div>
                    </div>
                </div>

                <!-- UPLOADED LOGS -->
                <div class="col-lg-5">
                    <div class="card modern-card shadow-sm">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold"><i class="bi bi-list-ul me-2"></i>Uploaded Logs (@_logs.Count)</span>
                            @if (_logs.Count > 0)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDeleteAllLogs">
                                    <i class="bi bi-trash me-1"></i>Clear All
                                </button>
                            }
                        </div>
                        <div class="card-body p-0">
                            @if (_loadingLogs)
                            {
                                <div class="text-center py-4"><div class="spinner-border"></div></div>
                            }
                            else if (_logs.Count == 0)
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox display-4 text-muted d-block mb-2"></i>
                                    <p>No logs uploaded yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                                    <table class="table table-hover mb-0">
                                        <thead class="sticky-top bg-light">
                                            <tr>
                                                <th>File Name</th>
                                                <th>Size</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var log in _logs)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@log.FileName</td>
                                                    <td><span class="badge bg-secondary">@FormatFileSize(log.SizeBytes)</span></td>
                                                    <td class="text-center">
                                                        <div class="btn-group">
                                                            <button class="btn btn-success btn-sm" @onclick="() => Analyze(log.Id)">
                                                                <i class="bi bi-cpu me-1"></i>Analyze
                                                            </button>
                                                            <button class="btn btn-info btn-sm" @onclick="() => ViewLog(log)">
                                                                <i class="bi bi-eye me-1"></i>View
                                                            </button>
                                                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteLog(log.Id, log.FileName)">
                                                                <i class="bi bi-trash me-1"></i>Delete
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LOG VIEWER MODAL -->
        @if (_showLogViewer)
        {
            <div class="custom-modal-backdrop" @onclick="CloseLogViewer"></div>
            <div class="custom-modal">
                <div class="custom-modal-dialog">
                    <div class="custom-modal-content">
                        <div class="custom-modal-header">
                            <h5 class="custom-modal-title"><i class="bi bi-file-earmark-text me-2"></i>@_activeLogName</h5>
                            <button class="custom-modal-close" @onclick="CloseLogViewer"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="custom-modal-body">@_logContent</div>
                        <div class="custom-modal-footer">
                            <button class="btn btn-secondary" @onclick="CloseLogViewer"><i class="bi bi-x-lg me-2"></i>Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- DELETE LOG CONFIRMATION -->
        @if (_showDeleteLogConfirm)
        {
            <div class="custom-modal-backdrop" @onclick="CancelDeleteLog"></div>
            <div class="custom-modal">
                <div class="custom-modal-dialog custom-modal-dialog-sm">
                    <div class="custom-modal-content">
                        <div class="custom-modal-header bg-danger">
                            <h5 class="custom-modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
                            <button class="custom-modal-close" @onclick="CancelDeleteLog"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="custom-modal-body">
                            <div class="text-center mb-3"><i class="bi bi-trash text-danger" style="font-size: 3rem;"></i></div>
                            <p class="mb-2">Are you sure you want to delete this log?</p>
                            <div class="alert alert-light border"><i class="bi bi-file-earmark-text me-2"></i><strong>@_logToDeleteName</strong></div>
                            <p class="small mb-0"><i class="bi bi-info-circle me-1"></i>This action cannot be undone.</p>
                        </div>
                        <div class="custom-modal-footer">
                            <button class="btn btn-light" @onclick="CancelDeleteLog"><i class="bi bi-x-lg me-2"></i>Cancel</button>
                            <button class="btn btn-danger" @onclick="DeleteLog"><i class="bi bi-trash me-2"></i>Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- DELETE ALL LOGS CONFIRMATION -->
        @if (_showDeleteAllLogsConfirm)
        {
            <div class="custom-modal-backdrop" @onclick="CancelDeleteAllLogs"></div>
            <div class="custom-modal">
                <div class="custom-modal-dialog custom-modal-dialog-sm">
                    <div class="custom-modal-content">
                        <div class="custom-modal-header bg-danger">
                            <h5 class="custom-modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Clear All Logs</h5>
                            <button class="custom-modal-close" @onclick="CancelDeleteAllLogs"><i class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="custom-modal-body">
                            <div class="text-center mb-3"><i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i></div>
                            <p class="mb-2">Are you sure you want to delete <strong class="text-danger">all @_logs.Count logs</strong>?</p>
                            <div class="alert alert-danger border-danger">
                                <i class="bi bi-shield-exclamation me-2"></i><strong>Warning:</strong> This will permanently delete all your log files.
                            </div>
                            <p class="small mb-0"><i class="bi bi-info-circle me-1"></i>This action cannot be undone.</p>
                        </div>
                        <div class="custom-modal-footer">
                            <button class="btn btn-light" @onclick="CancelDeleteAllLogs"><i class="bi bi-x-lg me-2"></i>Cancel</button>
                            <button class="btn btn-danger" @onclick="DeleteAllLogs"><i class="bi bi-trash me-2"></i>Delete All</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="alert alert-warning shadow-sm">
                <i class="bi bi-lock me-2"></i>You must be logged in to access the Log Center.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .log-stream-container { max-height: 500px; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.8rem; }
    .log-output-container { max-height: 300px; overflow-y: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 0.8rem; }
    .log-line { white-space: pre-wrap; word-break: break-all; }
    .log-table { table-layout: fixed; }
    .log-table tbody tr { cursor: pointer; }
    .log-table tbody tr:hover { background-color: rgba(var(--bs-primary-rgb), 0.1) !important; }
    .log-message { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .log-message-wrap { white-space: pre-wrap; word-break: break-word; font-size: 0.75rem; line-height: 1.3; }
    .log-row-error { background-color: rgba(220, 53, 69, 0.1); border-left: 3px solid #dc3545; }
    .log-row-warn { background-color: rgba(255, 193, 7, 0.1); border-left: 3px solid #ffc107; }
    .log-row-info { border-left: 3px solid #0dcaf0; }
    .log-row-debug { border-left: 3px solid #6c757d; opacity: 0.8; }
</style>

@code {
    // State
    private string _selectedModel = "claude-sonnet-4-5";

    // Upload Tab State
    private List<LogDto> _logs = new();
    private bool _loadingLogs = true;
    private string _pastedLogs = "";
    private bool _showLogViewer = false;
    private MarkupString _logContent = new("");
    private string _activeLogName = "";
    private bool _showDeleteLogConfirm = false;
    private bool _showDeleteAllLogsConfirm = false;
    private Guid _logToDeleteId = Guid.Empty;
    private string _logToDeleteName = "";

    // Live Streaming State
    private List<LiveLogEntry> _liveLogs = new();
    private HashSet<string> _selectedLiveLogs = new();
    private LiveLogStats _liveStats = new();
    private ElementReference _logContainer;
    private bool _isConnected = false;
    private bool _isSubscribed = false;
    private bool _isStreaming = false;
    private bool _autoScroll = true;
    private bool _selectAll = false;
    private bool _analyzing = false;
    private string _sessionId = "";
    private string _workerIdInput = "";
    private string _subscribedWorkerId = "";
    private string _filterLevel = "";
    private string _filterSource = "";
    private string _searchText = "";
    private List<WorkerRegistration> _availableWorkers = new();
    private bool _loadingWorkers;
    private string _selectedLogPath = "";
    private List<string> _selectedWorkerLogPaths = new();

    // Pull Log State
    private string _selectedPullWorkerId = "";
    private WorkerRegistration? SelectedPullWorker => _availableWorkers.FirstOrDefault(w => w.WorkerId == _selectedPullWorkerId);
    private string _pullLogPath = "";
    private int _pullLines = 100;
    private bool _pullFromEnd = true;
    private bool _pulling = false;
    private List<string> _pulledLogs = new();
    private string _pullError = "";
    private bool _analyzingPulledLogs = false;
    private CancellationTokenSource? _pullCts;

    private const string WorkerIdStorageKey = "bhb_livelog_worker_id";
    private const string LogPathStorageKey = "bhb_livelog_log_path";

    // SignalR Subscriptions
    private IDisposable? _logCreatedSub;
    private IDisposable? _logDeletedSub;
    private IDisposable? _allLogsDeletedSub;
    private IDisposable? _logPullResponseSub;
    private IDisposable? _liveLogReceivedSub;
    private IDisposable? _liveLogBatchSub;
    private IDisposable? _liveLogUpdateSub;
    private IDisposable? _sessionConnectedSub;
    private IDisposable? _sessionDisconnectedSub;
    private IDisposable? _analysisCompletedSub;
    private IDisposable? _analysisFailedSub;
    private IDisposable? _analysisStartedSub;

    private static readonly HashSet<string> AllowedExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".txt", ".log", ".json", ".xml", ".csv", ".png", ".jpg", ".jpeg", ".tiff", ".pdf"
    };

    private List<LiveLogEntry> FilteredLiveLogs => _liveLogs
        .Where(l => string.IsNullOrEmpty(_filterLevel) || l.Level == _filterLevel)
        .Where(l => string.IsNullOrEmpty(_filterSource) || l.Source == _filterSource)
        .Where(l => string.IsNullOrEmpty(_searchText) ||
                    l.Message.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    l.RawLine.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
        await InitializeSignalR();
        await RefreshWorkers();
        await LoadSavedWorkerIdAndLogPath();
    }

    // ==================== UPLOAD METHODS ====================

    private async Task LoadLogs()
    {
        try
        {
            _loadingLogs = true;
            _logs = await LogsApi.ListAsync();
        }
        finally
        {
            _loadingLogs = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        const long maxSize = 2 * 1024 * 1024;
        if (file.Size == 0 || file.Size > maxSize)
        {
            Toast.ShowError("Invalid file size. Maximum allowed is 2 MB.");
            return;
        }

        var extension = Path.GetExtension(file.Name);
        if (string.IsNullOrWhiteSpace(extension) || !AllowedExtensions.Contains(extension))
        {
            Toast.ShowError("Unsupported file type. Please upload a valid log file.");
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: maxSize);
            await LogsApi.UploadAsync(stream, file.Name, file.ContentType);
            await LoadLogs();
            Toast.ShowSuccess("Log file uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Upload failed: {ex.Message}");
        }
    }

    private async Task UploadPastedLogs()
    {
        try
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(_pastedLogs);
            await using var stream = new MemoryStream(bytes);
            var fileName = $"pasted-log-{DateTime.UtcNow:yyyyMMdd-HHmmss}.log";
            await LogsApi.UploadAsync(stream, fileName, "text/plain");
            _pastedLogs = "";
            await LoadLogs();
            Toast.ShowSuccess("Pasted logs uploaded successfully!");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Upload failed: {ex.Message}");
        }
    }

    private async Task ViewLog(LogDto log)
    {
        if (log.SizeBytes > 200 * 1024)
        {
            Toast.ShowWarning("Log is too large to view inline.");
            return;
        }

        try
        {
            _activeLogName = log.FileName;
            var content = await LogsApi.GetContentAsync(log.Id);
            _logContent = new MarkupString(ConvertToHtml(content));
            _showLogViewer = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load log: {ex.Message}");
        }
    }

    private void CloseLogViewer()
    {
        _showLogViewer = false;
        _logContent = new("");
        _activeLogName = "";
    }

