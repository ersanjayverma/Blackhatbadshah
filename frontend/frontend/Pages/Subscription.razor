@page "/subscription"
@attribute [Authorize]
@using shared.Dto
@using frontend.Services
@using Microsoft.AspNetCore.Authorization
@inject SubscriptionService SubscriptionApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>My Subscription - Blackhatbadshah</PageTitle>

<div class="container-fluid px-4 py-4">
    <h2 class="mb-4 fw-bold">
        <i class="bi bi-credit-card me-2"></i>Subscription Management
    </h2>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Current Plan Card -->
            <div class="col-lg-6">
                <div class="card shadow-lg h-100">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <h5 class="mb-0"><i class="bi bi-star me-2"></i>Current Plan</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold mb-0">@_subscription.PlanName</h3>
                            <span class="badge @GetStatusBadgeClass(_subscription.Status) fs-6">
                                @_subscription.Status
                            </span>
                        </div>

                        <p class="text-muted mb-2">Billing: @_subscription.BillingPeriod</p>

                        @if (_subscription.CurrentPeriodEnd.HasValue)
                        {
                            <p class="mb-3">
                                <i class="bi bi-calendar me-2"></i>
                                Renews: @_subscription.CurrentPeriodEnd.Value.ToLocalTime().ToString("MMMM dd, yyyy")
                            </p>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <a href="/pricing" class="btn btn-primary">
                                <i class="bi bi-arrow-up-circle me-2"></i>Upgrade Plan
                            </a>
                            @if (_subscription.PlanTier != PlanTier.Free)
                            {
                                <button class="btn btn-outline-danger" @onclick="ConfirmCancel" disabled="@_cancelling">
                                    @if (_cancelling)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle me-2"></i>
                                    }
                                    Cancel
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Usage Card -->
            <div class="col-lg-6">
                <div class="card shadow-lg h-100">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white;">
                        <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Usage This Month</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Analyses Used</span>
                            <span class="fw-bold">
                                @_subscription.UsedThisMonth / @(_subscription.MonthlyLimit == -1 ? "Unlimited" : _subscription.MonthlyLimit.ToString())
                            </span>
                        </div>

                        @if (_subscription.MonthlyLimit != -1)
                        {
                            var percentage = _subscription.MonthlyLimit > 0
                                ? Math.Min(100, (_subscription.UsedThisMonth * 100) / _subscription.MonthlyLimit)
                                : 0;
                            <div class="progress mb-3" style="height: 20px;">
                                <div class="progress-bar @(percentage > 80 ? "bg-warning" : "bg-success")"
                                     style="width: @percentage%">
                                    @percentage%
                                </div>
                            </div>

                            @if (percentage >= 80)
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    You're approaching your monthly limit. Consider upgrading!
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-success mb-3">
                                <i class="bi bi-infinity me-2"></i>
                                Unlimited analyses available with your Enterprise plan
                            </div>
                        }

                        <h6 class="mt-4 mb-3">Available Models:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var model in _subscription.AllowedModels.Take(6))
                            {
                                <span class="badge bg-secondary">@model</span>
                            }
                            @if (_subscription.AllowedModels.Count > 6)
                            {
                                <span class="badge bg-info">+@(_subscription.AllowedModels.Count - 6) more</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            <div class="col-12">
                <div class="card shadow-lg">
                    <div class="card-header bg-gradient d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                        <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Payment History</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (_payments.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-2">No payment history yet</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th>Invoice</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in _payments)
                                        {
                                            <tr>
                                                <td>@payment.PaymentDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                                <td>@payment.Currency @payment.Amount.ToString("N2")</td>
                                                <td>
                                                    <span class="badge @GetPaymentStatusBadge(payment.Status)">
                                                        @payment.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(payment.InvoiceId))
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-download"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserSubscriptionDto _subscription = new();
    private List<PaymentHistoryDto> _payments = new();
    private bool _loading = true;
    private bool _cancelling = false;

    protected override async Task OnInitializedAsync()
    {
        _subscription = await SubscriptionApi.GetCurrentSubscriptionAsync();
        _payments = await SubscriptionApi.GetPaymentHistoryAsync();
        _loading = false;
    }

    private async Task ConfirmCancel()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to cancel your subscription? You will retain access until the end of your billing period.");

        if (confirmed)
        {
            try
            {
                _cancelling = true;
                StateHasChanged();

                await SubscriptionApi.CancelSubscriptionAsync();
                Nav.NavigateTo("/subscription", forceLoad: true);
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Failed to cancel: {ex.Message}");
            }
            finally
            {
                _cancelling = false;
            }
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Cancelled" => "bg-danger",
        "Halted" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetPaymentStatusBadge(string status) => status switch
    {
        "Captured" => "bg-success",
        "Failed" => "bg-danger",
        "Refunded" => "bg-info",
        _ => "bg-secondary"
    };
}
