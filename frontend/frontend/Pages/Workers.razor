@page "/workers"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.SignalR.Client
@using shared.Dto
@using frontend.Services
@inject WorkerService WorkerApi
@inject WorkerAgentService WorkerAgentApi
@inject HubConnectionService HubService
@inject IAccessTokenProvider TokenProvider
@inject ToastService Toast
@inject IJSRuntime JS
@inject LiveLogService LiveLogApi
@inject NavigationManager Navigation
@implements IAsyncDisposable

<AuthorizeView>
    <Authorized>
        <div class="container-fluid px-4 py-4">

            @if (!_hasWorkerConfig)
            {
                <!-- NO CONFIG - REDIRECT TO SETUP -->
                <div class="card modern-card shadow-lg border-info">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>Worker Setup Required
                        </h5>
                    </div>
                    <div class="card-body text-center py-5">
                        <i class="bi bi-cpu display-1 text-info mb-4"></i>
                        <h4 class="fw-bold mb-3">No Workers Configured</h4>
                        <p class="mb-4">
                            You need to register workers before you can view their status and pull logs.
                            Go to <strong>My Workers</strong> to initialize your configuration and register your first worker.
                        </p>
                        <button class="btn btn-primary btn-lg" @onclick="GoToMyWorkers">
                            <i class="bi bi-gear me-2"></i>Go to My Workers
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- HEADER -->
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                    <div>
                        <h2 class="mb-1 fw-bold text-gradient">
                            <i class="bi bi-hdd-network me-2"></i>Live Workers
                        </h2>
                        <p class="mb-0">View connected workers and pull logs in real-time</p>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-success px-3 py-2">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                            @_workers.OnlineCount Online
                        </span>
                        <span class="badge bg-secondary px-3 py-2">
                            @_workers.TotalCount Total
                        </span>
                        <button class="btn btn-outline-secondary" @onclick="GoToMyWorkers">
                            <i class="bi bi-gear me-1"></i>Manage Workers
                        </button>
                        <button class="btn btn-outline-primary" @onclick="RefreshWorkers" disabled="@_loading">
                            @if (_loading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-clockwise me-1"></i>
                            }
                            Refresh
                        </button>
                    </div>
                </div>

                <!-- SEARCH BAR -->
                <div class="card modern-card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-search me-2"></i>Search by Hostname
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Enter hostname to filter..."
                                           @bind="_searchHostname" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                                    <button class="btn btn-primary" @onclick="SearchWorkers">
                                        <i class="bi bi-search"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(_searchHostname))
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="onlineOnly"
                                           @bind="_showOnlineOnly" @bind:after="FilterWorkers" />
                                    <label class="form-check-label" for="onlineOnly">
                                        Show online workers only
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- WORKERS LIST -->
                @if (_loading && _workers.Workers.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 fw-bold">Loading workers...</p>
                    </div>
                }
                else if (_filteredWorkers.Count == 0)
                {
                    <div class="card modern-card shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-hdd-network display-1 fw-bold mb-3"></i>
                            <h5 class="fw-bold">No Live Workers</h5>
                            <p class="fw-bold">
                                @if (!string.IsNullOrEmpty(_searchHostname))
                                {
                                    <span>No workers matching "@_searchHostname"</span>
                                }
                                else if (_showOnlineOnly)
                                {
                                    <span>No online workers found</span>
                                }
                                else
                                {
                                    <span>Workers you've registered will appear here when they connect.</span>
                                }
                            </p>
                            <button class="btn btn-primary" @onclick="GoToMyWorkers">
                                <i class="bi bi-gear me-1"></i>Manage Workers
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var worker in _filteredWorkers)
                        {
                            <div class="col-lg-6 col-xl-4">
                                <div class="card modern-card shadow-sm h-100 @(worker.IsOnline ? "border-success" : "border-secondary") border-2">
                                    <div class="card-header d-flex justify-content-between align-items-center @(worker.IsOnline ? "bg-success bg-opacity-10" : "")">
                                        <div>
                                            <h6 class="mb-0 fw-bold">
                                                <i class="bi bi-hdd me-2"></i>@worker.Hostname
                                            </h6>
                                            <small class="fw-bold">@worker.WorkerId</small>
                                        </div>
                                        <span class="badge @(worker.IsOnline ? "bg-success" : "bg-secondary")">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                                            @(worker.IsOnline ? "Online" : "Offline")
                                        </span>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <small class="fw-bold d-block">OS Version</small>
                                            <span class="text-truncate d-block" title="@worker.OsVersion">
                                                @(worker.OsVersion.Length > 40 ? worker.OsVersion[..40] + "..." : worker.OsVersion)
                                            </span>
                                        </div>

                                        @if (worker.LastMetrics != null)
                                        {
                                            <div class="row g-2 mb-3">
                                                <div class="col-4">
                                                    <div class="text-center p-2 bg-light rounded">
                                                        <div class="fw-bold text-primary">@worker.LastMetrics.CpuPercent.ToString("F1")%</div>
                                                        <small class="fw-bold">CPU</small>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="text-center p-2 bg-light rounded">
                                                        <div class="fw-bold text-info">@worker.LastMetrics.MemoryPercent.ToString("F1")%</div>
                                                        <small class="fw-bold">Memory</small>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="text-center p-2 bg-light rounded">
                                                        <div class="fw-bold text-warning">@worker.LastMetrics.DiskPercent.ToString("F1")%</div>
                                                        <small class="fw-bold">Disk</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <div class="mb-3">
                                            <small class="fw-bold d-block mb-1">Available Log Paths</small>
                                            @if (worker.AvailableLogPaths.Count == 0)
                                            {
                                                <span class="fw-bold">No log paths configured</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var path in worker.AvailableLogPaths.Take(3))
                                                    {
                                                        <span class="badge bg-light text-dark border" title="@path">
                                                            @Path.GetFileName(path)
                                                        </span>
                                                    }
                                                    @if (worker.AvailableLogPaths.Count > 3)
                                                    {
                                                        <span class="badge bg-secondary">+@(worker.AvailableLogPaths.Count - 3) more</span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="mb-3">
                                            <small class="fw-bold d-block">Last Heartbeat</small>
                                            <span>@worker.LastHeartbeat.ToLocalTime().ToString("g")</span>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary flex-grow-1"
                                                    @onclick="() => ShowLogPullModal(worker)"
                                                    disabled="@(!worker.IsOnline)">
                                                <i class="bi bi-download me-1"></i>Pull Logs
                                            </button>
                                            <a href="/livelogs" class="btn btn-sm btn-primary flex-grow-1">
                                                <i class="bi bi-broadcast me-1"></i>Live Logs
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- LOG PULL MODAL -->
        @if (_showLogPullModal && _selectedWorker != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-download me-2"></i>Pull Logs from @_selectedWorker.Hostname
                            </h5>
                            <button type="button" class="btn-close" @onclick="CloseLogPullModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Select Log File</label>
                                <select class="form-select" @bind="_selectedLogPath">
                                    <option value="">-- Select a log file --</option>
                                    @foreach (var path in _selectedWorker.AvailableLogPaths)
                                    {
                                        <option value="@path">@path</option>
                                    }
                                </select>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Number of Lines</label>
                                    <input type="number" class="form-control" @bind="_pullLines" min="10" max="1000" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Read From</label>
                               <select class="form-select" @bind="_pullFromEnd">
                                <option value="@true">End (tail)</option>
                                <option value="@false">Beginning (head)</option>
                            </select>
                                </div>
                            </div>

                            @if (_pulledLogs.Count > 0)
                            {
                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold mb-0">
                                            <i class="bi bi-file-text me-1"></i>Pulled Logs (@_pulledLogs.Count lines)
                                        </label>
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CopyPulledLogs">
                                                <i class="bi bi-clipboard me-1"></i>Copy
                                            </button>
                                            <button class="btn btn-sm btn-primary" @onclick="AnalyzePulledLogs"
                                                    disabled="@_analyzingLogs">
                                                @if (_analyzingLogs)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cpu me-1"></i>
                                                }
                                                Analyse
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold mb-1">AI Model</label>
                                        <select class="form-select form-select-sm" @bind="_selectedModel">
                                            <optgroup label="Claude (Anthropic)">
                                                <option value="claude-sonnet-4-5">Claude Sonnet 4.5 (Recommended)</option>
                                                <option value="claude-opus-4-5">Claude Opus 4.5 (Most Powerful)</option>
                                                <option value="claude-sonnet-3-5">Claude Sonnet 3.5</option>
                                            </optgroup>
                                            <optgroup label="GPT (OpenAI)">
                                                <option value="gpt-4o">GPT-4o</option>
                                                <option value="gpt-4-turbo">GPT-4 Turbo</option>
                                                <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
                                            </optgroup>
                                            <optgroup label="Open Source (TogetherAI)">
                                                <option value="gpt-oss-120b">gpt-oss-120b</option>
                                                <option value="together-llama-3.1-405b">Llama 3.1 405B</option>
                                                <option value="together-mixtral-8x7b">Mixtral 8x7B</option>
                                                <option value="together-qwen">Qwen</option>
                                            </optgroup>
                                        </select>
                                    </div>
                                    <div class="log-output-container border rounded p-2 bg-dark text-light">
                                        @foreach (var line in _pulledLogs)
                                        {
                                            <div class="log-line">@line</div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(_pullError))
                            {
                                <div class="alert alert-danger mt-3 mb-0">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@_pullError
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseLogPullModal">Close</button>
                            @if (_pulling)
                            {
                                <button type="button" class="btn btn-warning" @onclick="CancelPullLogs">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" @onclick="PullLogs"
                                        disabled="@string.IsNullOrEmpty(_selectedLogPath)">
                                    <i class="bi bi-download me-1"></i>Pull Logs
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>

    <NotAuthorized>
        <div class="container mt-5">
            <div class="alert alert-warning shadow-sm">
                <i class="bi bi-lock me-2"></i>
                You must be logged in to view workers.
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .log-output-container {
        max-height: 300px;
        overflow-y: auto;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.8rem;
    }

    .log-line {
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

@code {
private WorkerListResponse _workers = new();
private List<WorkerRegistration> _filteredWorkers = new();
private bool _loading = true;
private string _searchHostname = string.Empty;
private bool _showOnlineOnly = false;
private bool _hasWorkerConfig = false;

// Log pull modal state
private bool _showLogPullModal = false;
private WorkerRegistration? _selectedWorker;
private string _selectedLogPath = string.Empty;
private int _pullLines = 100;
private bool _pullFromEnd = true;
private bool _pulling = false;
private List<string> _pulledLogs = new();
private string _pullError = string.Empty;
private bool _analyzingLogs = false;
private string _selectedModel = "claude-sonnet-4-5";
private CancellationTokenSource? _pullCts;

// SignalR subscriptions
private IDisposable? _workerRegisteredSub;
private IDisposable? _logPullResponseSub;

protected override async Task OnInitializedAsync()
{
    await CheckWorkerConfig();
        
    if (_hasWorkerConfig)
    {
        await InitializeSignalR();
        await RefreshWorkers();
    }
    else
    {
        _loading = false;
    }
}

private async Task CheckWorkerConfig()
{
    try
    {
        var config = await WorkerAgentApi.GetConfigAsync();
        _hasWorkerConfig = config.HasConfig;
    }
    catch
    {
        // If we can't check config, assume we don't have one
        _hasWorkerConfig = false;
    }
}

private void GoToMyWorkers()
{
    Navigation.NavigateTo("/admin/workers");
}

private async Task InitializeSignalR()
    {
        try
        {
            await HubService.InitializeAsync(async () =>
            {
                var tokenResult = await TokenProvider.RequestAccessToken();
                if (tokenResult.TryGetToken(out var token))
                {
                    return token.Value;
                }
                return null;
            });
            await HubService.StartAsync();

            // Subscribe to worker registration events
            _workerRegisteredSub = HubService.On<object>("WorkerRegistered", async (data) =>
            {
                // Just refresh silently - no toast to avoid spam
                await RefreshWorkers();
                await InvokeAsync(StateHasChanged);
            });

            // Subscribe to log pull response
            _logPullResponseSub = HubService.On<LogPullResponse>("LogPullResponse", async (response) =>
            {
                _pullCts?.Cancel(); // Cancel timeout
                _pulling = false;

                if (response.Success)
                {
                    _pulledLogs = response.Lines;
                    _pullError = string.Empty;
                    Toast.ShowSuccess($"Pulled {response.Lines.Count} lines from {response.LogPath}");
                }
                else
                {
                    _pullError = response.Error ?? "Failed to pull logs";
                    Toast.ShowError(_pullError);
                }

                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection failed: {ex.Message}");
        }
    }

    private async Task RefreshWorkers()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _workers = await WorkerApi.GetWorkersAsync(_searchHostname);
            FilterWorkers();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to load workers: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SearchWorkers()
    {
        await RefreshWorkers();
    }

    private async Task ClearSearch()
    {
        _searchHostname = string.Empty;
        await RefreshWorkers();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchWorkers();
        }
    }

    private void FilterWorkers()
    {
        _filteredWorkers = _workers.Workers
            .Where(w => !_showOnlineOnly || w.IsOnline)
            .ToList();
    }

    private void ShowLogPullModal(WorkerRegistration worker)
    {
        _selectedWorker = worker;
        _selectedLogPath = worker.AvailableLogPaths.FirstOrDefault() ?? string.Empty;
        _pullLines = 100;
        _pullFromEnd = true;
        _pulledLogs.Clear();
        _pullError = string.Empty;
        _showLogPullModal = true;
    }

    private void CloseLogPullModal()
    {
        _showLogPullModal = false;
        _selectedWorker = null;
        _pulledLogs.Clear();
        _pullError = string.Empty;
    }

    private async Task PullLogs()
    {
        if (_selectedWorker == null || string.IsNullOrEmpty(_selectedLogPath)) return;

        _pulling = true;
        _pullError = string.Empty;
        _pulledLogs.Clear();
        _pullCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Subscribe to worker to receive response
            await HubService.Connection.SendAsync("SubscribeToWorker", _selectedWorker.WorkerId);

            var success = await WorkerApi.PullLogsAsync(
                _selectedWorker.WorkerId,
                _selectedLogPath,
                _pullLines,
                _pullFromEnd);

            if (!success)
            {
                _pulling = false;
                _pullError = "Failed to send pull request";
                Toast.ShowError(_pullError);
                return;
            }

            // Set timeout - 30 seconds max wait
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(30000, _pullCts.Token);
                    if (_pulling)
                    {
                        _pulling = false;
                        _pullError = "Request timed out after 30 seconds";
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException)
                {
                    // Normal cancellation
                }
            });
        }
        catch (Exception ex)
        {
            _pulling = false;
            _pullError = ex.Message;
            Toast.ShowError($"Failed to pull logs: {ex.Message}");
        }

        StateHasChanged();
    }

    private void CancelPullLogs()
    {
        _pullCts?.Cancel();
        _pulling = false;
        _pullError = "Request cancelled";
        StateHasChanged();
    }

    private async Task CopyPulledLogs()
    {
        if (_pulledLogs.Count == 0) return;

        try
        {
            var content = string.Join("\n", _pulledLogs);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", content);
            Toast.ShowSuccess($"Copied {_pulledLogs.Count} lines to clipboard");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to copy: {ex.Message}");
        }
    }

    private async Task AnalyzePulledLogs()
    {
        if (_pulledLogs.Count == 0)
        {
            Toast.ShowWarning("No logs to analyze");
            return;
        }

        _analyzingLogs = true;
        StateHasChanged();

        try
        {
            var content = string.Join("\n", _pulledLogs);
            var workerId = _selectedWorker?.WorkerId;

            await LiveLogApi.AnalyzeContentAsync(content, null, workerId, _selectedModel);

            Toast.ShowSuccess($"Analysis queued for {_pulledLogs.Count} log lines! Check Reports page.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to queue analysis: {ex.Message}");
        }
        finally
        {
            _analyzingLogs = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _workerRegisteredSub?.Dispose();
        _logPullResponseSub?.Dispose();
    }
}
