# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Database Configuration (Azure SQL Server)
ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Azure Blob Storage Configuration
AzureBlob__ConnectionString=DefaultEndpointsProtocol=https;AccountName=your-account-name;AccountKey=your-account-key;EndpointSuffix=core.windows.net

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual credentials
# 3. NEVER commit the .env file to version control
# 4. Docker Compose will automatically load the .env file from this directory
