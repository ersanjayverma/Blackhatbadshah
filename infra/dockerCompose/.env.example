# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# TogetherAI API Configuration (Optional)
TOGETHER_API_KEY=your_together_api_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Database Configuration (Azure SQL Server)
ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Azure Blob Storage Configuration (Optional)
AzureBlob__ConnectionString=DefaultEndpointsProtocol=https;AccountName=your-account-name;AccountKey=your-account-key;EndpointSuffix=core.windows.net

# Razorpay Configuration
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Keycloak Configuration
# Get this from Keycloak Admin Console -> Clients -> admin-cli -> Credentials
KEYCLOAK_ADMIN_CLIENT_SECRET=your_keycloak_admin_client_secret

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual credentials
# 3. NEVER commit the .env file to version control
# 4. Docker Compose will automatically load the .env file from this directory
#
# RAZORPAY SETUP:
# 1. Create an account at https://razorpay.com
# 2. Go to Dashboard -> Settings -> API Keys and generate keys
# 3. Go to Dashboard -> Products -> Plans and create subscription plans:
#    - Pro Monthly (₹999/month)
#    - Pro Yearly (₹9588/year)
#    - Enterprise Monthly (₹4999/month)
#    - Enterprise Yearly (₹47988/year)
# 4. Update RazorpayPlanIdMonthly/Yearly in the database for each plan
# 5. Set up webhook at Dashboard -> Settings -> Webhooks pointing to:
#    https://api.blackhatbadshah.com/api/webhooks/razorpay
#
# KEYCLOAK SETUP:
# 1. Create realm "blackhatbadshah"
# 2. Create client "admin-cli" with Client Authentication enabled
# 3. Copy the client secret from Credentials tab
