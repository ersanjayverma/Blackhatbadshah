[Unit]
Description=BHB Worker - Log Pusher and Metrics Service
Documentation=https://github.com/blackhatbadshah/bhbworker
After=network.target

[Service]
# Keep notify only if your app calls sd_notify / UseSystemd in WorkerService.
# If not, change to: Type=simple
Type=notify

WorkingDirectory=/opt/bhbworker
ExecStart=/opt/bhbworker/BHBWorker

Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=bhbworker

# RUN AS ROOT (ADMIN)
# NOTE: do NOT set User/Group, default is root

# FULL ACCESS (no sandboxing / no path restrictions)
# Removed NoNewPrivileges, ProtectSystem, ProtectHome, PrivateTmp, etc.
# Removed ReadOnlyPaths/ReadWritePaths restrictions

# Environment
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
