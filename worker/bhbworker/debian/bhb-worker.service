[Unit]
Description=BHB Worker - Log streaming and system monitoring agent
Documentation=https://blackhatbadshah.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/bhb-worker/bhb-worker
WorkingDirectory=/opt/bhb-worker
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=bhb-worker

# Run as root with full system access
User=root
Group=root

# Environment
Environment=DOTNET_ENVIRONMENT=Production
Environment=HOME=/root

# Allow child processes to be properly managed
KillMode=mixed

# Increase timeout for startup
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
